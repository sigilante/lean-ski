-- SKIlark, compiled: every word a function stack -> result, a program the
-- composition of its words, quotations defunctionalized (skilark.joy).
nat    === Zero | Suc nat
item   === Num nat | Quot quot
stack  === Empty | Push item stack
quot   === Q1 | Q2 | Q3 | Q4 | Q5 | Q6 | Q7 | Q8 | Q9 | Q10 | Q11 | Q12 | Q13 | Q14 | Q15 | Q16 | Q17 | Q18 | Q19 | Q20 | Q21 | Q22 | Q23 | Q24 | Q25 | Q26 | Q27 | Q28 | Q29 | Q30 | Q31 | Q32 | Q33 | Q34 | Q35 | Q36 | Q37 | Q38 | Q39 | Q40 | Q41 | Q42 | Q43 | Q44 | Q45 | Q46 | Q47 | Q48 | QCons item quot | QUnit item | QThen quot
result === RVal stack | RErr | RTime

add m n = n |> { Zero m; Suc k (Suc (add m k)) }
mul m n = n |> { Zero Zero; Suc k (add m (mul m k)) }

-- composition, threading the result
seq f g s = f s |> { RVal t (g t); RErr RErr; RTime RTime }
idW s = RVal s

wDup s = s |> { Empty RErr; Push a t (RVal (Push a (Push a t))) }
wSwap s = s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (RVal (Push b (Push a u))) }) }
wPop s = s |> { Empty RErr; Push a t (RVal t) }
wQcons s = s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (t |> { Empty RErr; Push b u (RVal (Push (Quot (QCons b r)) u)) }) }) }
-- [P] [Q] cat == [[P] i Q]: cons the left quotation onto "i then Q"
wCat s = s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (t |> { Empty RErr; Push b u (b |> { Num m RErr; Quot l (RVal (Push (Quot (QCons (Quot l) (QThen r))) u)) }) }) }) }
wUnit s = s |> { Empty RErr; Push a t (RVal (Push (Quot (QUnit a)) t)) }
wDip ap s = s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (t |> { Empty RErr; Push b u (ap r u |> { RVal v (RVal (Push b v)); RErr RErr; RTime RTime }) }) }) }
wDo ap s = s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot r (ap r t) }) }
wIfz ap s = s |> { Empty RErr; Push a t (a |> { Num n RErr; Quot sc (t |> { Empty RErr; Push b u (b |> { Num n RErr; Quot z (u |> { Empty RErr; Push c v (c |> { Num n (n |> { Zero (ap z v); Suc m (ap sc (Push (Num m) v)) }); Quot r RErr }) }) }) }) }) }
wLit n s = RVal (Push (Num n) s)
wQuote r s = RVal (Push (Quot r) s)
wAdd s = s |> { Empty RErr; Push a t (t |> { Empty RErr; Push b u (a |> { Num m (b |> { Num n (RVal (Push (Num (add m n)) u)); Quot r RErr }); Quot r RErr }) }) }

one   := Suc Zero
two   := Suc one
five  := Suc (Suc (Suc two))
ten   := add five five
fuel  := mul ten (add ten ten)

-- the eliminator of quot: Joy's i is one case; fuel is one unit per apply
apply f q s = f |> { Zero RTime; Suc g (q |> { Q1 (b1 (apply g) s); Q2 (b2 (apply g) s); Q3 (b3 (apply g) s); Q4 (b4 (apply g) s); Q5 (b5 (apply g) s); Q6 (b6 (apply g) s); Q7 (b7 (apply g) s); Q8 (b8 (apply g) s); Q9 (b9 (apply g) s); Q10 (b10 (apply g) s); Q11 (b11 (apply g) s); Q12 (b12 (apply g) s); Q13 (b13 (apply g) s); Q14 (b14 (apply g) s); Q15 (b15 (apply g) s); Q16 (b16 (apply g) s); Q17 (b17 (apply g) s); Q18 (b18 (apply g) s); Q19 (b19 (apply g) s); Q20 (b20 (apply g) s); Q21 (b21 (apply g) s); Q22 (b22 (apply g) s); Q23 (b23 (apply g) s); Q24 (b24 (apply g) s); Q25 (b25 (apply g) s); Q26 (b26 (apply g) s); Q27 (b27 (apply g) s); Q28 (b28 (apply g) s); Q29 (b29 (apply g) s); Q30 (b30 (apply g) s); Q31 (b31 (apply g) s); Q32 (b32 (apply g) s); Q33 (b33 (apply g) s); Q34 (b34 (apply g) s); Q35 (b35 (apply g) s); Q36 (b36 (apply g) s); Q37 (b37 (apply g) s); Q38 (b38 (apply g) s); Q39 (b39 (apply g) s); Q40 (b40 (apply g) s); Q41 (b41 (apply g) s); Q42 (b42 (apply g) s); Q43 (b43 (apply g) s); Q44 (b44 (apply g) s); Q45 (b45 (apply g) s); Q46 (b46 (apply g) s); Q47 (b47 (apply g) s); Q48 (b48 (apply g) s); QCons x r (apply g r (Push x s)); QUnit x (RVal (Push x s)); QThen b (seq (wDo (apply g)) (apply g b) s) }) }
applyU q s = q |> { Q1 (b1 applyU s); Q2 (b2 applyU s); Q3 (b3 applyU s); Q4 (b4 applyU s); Q5 (b5 applyU s); Q6 (b6 applyU s); Q7 (b7 applyU s); Q8 (b8 applyU s); Q9 (b9 applyU s); Q10 (b10 applyU s); Q11 (b11 applyU s); Q12 (b12 applyU s); Q13 (b13 applyU s); Q14 (b14 applyU s); Q15 (b15 applyU s); Q16 (b16 applyU s); Q17 (b17 applyU s); Q18 (b18 applyU s); Q19 (b19 applyU s); Q20 (b20 applyU s); Q21 (b21 applyU s); Q22 (b22 applyU s); Q23 (b23 applyU s); Q24 (b24 applyU s); Q25 (b25 applyU s); Q26 (b26 applyU s); Q27 (b27 applyU s); Q28 (b28 applyU s); Q29 (b29 applyU s); Q30 (b30 applyU s); Q31 (b31 applyU s); Q32 (b32 applyU s); Q33 (b33 applyU s); Q34 (b34 applyU s); Q35 (b35 applyU s); Q36 (b36 applyU s); Q37 (b37 applyU s); Q38 (b38 applyU s); Q39 (b39 applyU s); Q40 (b40 applyU s); Q41 (b41 applyU s); Q42 (b42 applyU s); Q43 (b43 applyU s); Q44 (b44 applyU s); Q45 (b45 applyU s); Q46 (b46 applyU s); Q47 (b47 applyU s); Q48 (b48 applyU s); QCons x r (applyU r (Push x s)); QUnit x (RVal (Push x s)); QThen b (seq (wDo applyU) (applyU b) s) }

-- static quotations, hoisted
b1 ap = wSwap
b2 ap = seq (wQuote Q5) (seq (wQuote Q6) ((wIfz ap)))
b3 ap = seq (wQuote Q7) (seq (wQuote Q8) ((wIfz ap)))
b4 ap = seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q9) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q10) (seq (wQuote Q11) ((wIfz ap)))))))))))))))))))))))))))))))))))
b5 ap = seq wSwap (seq (wQuote Q12) (seq (wQuote Q13) ((wIfz ap))))
b6 ap = seq (wQuote Q14) (seq (wQuote Q15) ((wIfz ap)))
b7 ap = seq wSwap (seq (wQuote Q16) (seq (wQuote Q17) ((wIfz ap))))
b8 ap = seq (wQuote Q18) (seq (wQuote Q15) ((wIfz ap)))
b9 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q10) (seq (wQuote Q11) ((wIfz ap))))))
b10 ap = wPop
b11 ap = seq (wQuote Q19) (seq (wQuote Q15) ((wIfz ap)))
b12 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q20) (seq (wQuote Q21) ((wIfz ap))))))
b13 ap = seq (wQuote Q22) (seq (wQuote Q15) ((wIfz ap)))
b14 ap = seq wSwap (seq (wQuote Q23) (seq (wQuote Q24) ((wIfz ap))))
b15 ap = seq (wLit Zero) ((wDo ap))
b16 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q25) (seq (wQuote Q26) ((wIfz ap))))))
b17 ap = seq (wQuote Q27) (seq (wQuote Q15) ((wIfz ap)))
b18 ap = seq wSwap (seq (wQuote Q28) (seq (wQuote Q29) ((wIfz ap))))
b19 ap = seq wSwap (wAdd)
b20 ap = seq wPop (seq wSwap (seq (wQuote Q30) (seq (wQuote Q31) ((wIfz ap)))))
b21 ap = seq (wQuote Q32) (seq (wQuote Q15) ((wIfz ap)))
b22 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q33) (seq (wQuote Q34) ((wIfz ap))))))
b23 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q35) (seq (wQuote Q36) ((wIfz ap))))))
b24 ap = seq (wQuote Q12) (seq (wQuote Q15) ((wIfz ap)))
b25 ap = seq wPop (seq wSwap (seq (wQuote Q37) (seq (wQuote Q31) ((wIfz ap)))))
b26 ap = seq (wQuote Q38) (seq (wQuote Q15) ((wIfz ap)))
b27 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q39) (seq (wQuote Q26) ((wIfz ap))))))
b28 ap = seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q40) (seq (wQuote Q41) ((wIfz ap))))))
b29 ap = seq (wQuote Q16) (seq (wQuote Q15) ((wIfz ap)))
b30 ap = (wLit Zero)
b31 ap = seq (wQuote Q15) (seq (wQuote Q15) ((wIfz ap)))
b32 ap = seq wSwap (seq wAdd (seq wSwap (seq (wQuote Q15) (seq (wQuote Q42) ((wIfz ap))))))
b33 ap = seq wPop (seq wSwap (seq (wQuote Q15) (seq (wQuote Q42) ((wIfz ap)))))
b34 ap = seq (wQuote Q43) (seq (wQuote Q15) ((wIfz ap)))
b35 ap = seq wPop (seq wSwap (seq (wQuote Q15) (seq (wQuote Q44) ((wIfz ap)))))
b36 ap = seq (wQuote Q45) (seq (wQuote Q15) ((wIfz ap)))
b37 ap = idW
b38 ap = seq wSwap (seq wAdd (seq wSwap (seq (wQuote Q15) (seq (wQuote Q31) ((wIfz ap))))))
b39 ap = seq wPop (seq wSwap (seq (wQuote Q15) (seq (wQuote Q31) ((wIfz ap)))))
b40 ap = seq wPop (seq wSwap (seq (wQuote Q15) (seq (wQuote Q46) ((wIfz ap)))))
b41 ap = seq (wQuote Q47) (seq (wQuote Q15) ((wIfz ap)))
b42 ap = seq (wQuote Q48) (seq (wQuote Q15) ((wIfz ap)))
b43 ap = seq wSwap (seq wAdd (seq wSwap (seq (wQuote Q48) (seq (wQuote Q31) ((wIfz ap))))))
b44 ap = seq (wQuote Q30) (seq (wQuote Q15) ((wIfz ap)))
b45 ap = seq wSwap (seq wAdd (seq wSwap (seq (wQuote Q30) (seq (wQuote Q31) ((wIfz ap))))))
b46 ap = seq (wQuote Q37) (seq (wQuote Q15) ((wIfz ap)))
b47 ap = seq wSwap (seq wAdd (seq wSwap (seq (wQuote Q37) (seq (wQuote Q31) ((wIfz ap))))))
b48 ap = (wLit (Suc Zero))

-- programs, from skilark.joy.compiled
ccsplit ap = seq (wLit Zero) (seq (wLit Zero) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q2) (seq (wDip ap) (seq (wDo ap) (seq (wQuote Q1) (seq (wDip ap) (seq wSwap (seq (wQuote Q3) (seq (wDip ap) (seq (wDo ap) (seq wSwap (seq (wQuote Q4) ((wDip ap)))))))))))))))))))))))))))))))))))))))))))))))))))))))))
rcsplit := ccsplit (apply fuel) Empty
ucsplit := ccsplit applyU Empty

bool === T | F
appendS s t = s |> { Empty t; Push a u (Push a (appendS u t)) }

-- the committed split's verifier: the program leaves the commitment C above
-- the sum S it recomputed, and it accepts when they are equal (skilark.zk)
eqN m n = m |> { Zero (n |> { Zero T; Suc q F }); Suc p (n |> { Zero F; Suc q (eqN p q) }) }
acceptEq r = r |> { RVal s (s |> { Empty F; Push a t (a |> { Num m (t |> { Empty F; Push b u (b |> { Num n (eqN m n); Quot q F }) }); Quot q F }) }); RErr F; RTime F }
vcsplit x w = acceptEq (ccsplit applyU (appendS x w))
vcsplitB x r = vcsplit x (decBits r)
bitNum b = b (Num (Suc Zero)) (Num Zero)
decBits qr0 = qr0 (\qb0. \qr1. Push (bitNum qb0) (qr1 (\qb1. \qr2. Push (bitNum qb1) (qr2 (\qb2. \qr3. Push (bitNum qb2) (qr3 (\qb3. \qr4. Push (bitNum qb3) (qr4 (\qb4. \qr5. Push (bitNum qb4) (qr5 (\qb5. \qr6. Push (bitNum qb5) (qr6 (\qb6. \qr7. Push (bitNum qb6) (qr7 (\qb7. \qr8. Push (bitNum qb7) (qr8 (\qb8. \qr9. Push (bitNum qb8) (qr9 (\qb9. \qr10. Push (bitNum qb9) (qr10 (\qb10. \qr11. Push (bitNum qb10) (qr11 (\qb11. \qr12. Push (bitNum qb11) (qr12 (\qb12. \qr13. Push (bitNum qb12) (qr13 (\qb13. \qr14. Push (bitNum qb13) (qr14 (\qb14. \qr15. Push (bitNum qb14) (qr15 (\qb15. \qr16. Push (bitNum qb15) (qr16 (\qb16. \qr17. Push (bitNum qb16) (qr17 (\qb17. \qr18. Push (bitNum qb17) (qr18 (\qb18. \qr19. Push (bitNum qb18) (qr19 (\qb19. \qr20. Push (bitNum qb19) (qr20 (\qb20. \qr21. Push (bitNum qb20) (qr21 (\qb21. \qr22. Push (bitNum qb21) (qr22 (\qb22. \qr23. Push (bitNum qb22) (Push (bitNum qr23) Empty))))))))))))))))))))))))))))))))))))))))))))))
