/-- The front end compiles the ASCII text to every term `skijack` emits
    (`Front.agrees_termOf`), and to no other (`Front.agrees_termOf_rev`). -/
theorem wordsToNumbers_agrees : agrees (compileWith false wordsToNumbersText) wordsToNumbersTerms = true := by
  decide +kernel

/-- And the Unicode text, to the same terms. -/
theorem wordsToNumbers_unicode_agrees : agrees (compileWith true wordsToNumbersTextU) wordsToNumbersTerms = true := by
  decide +kernel

/-- The simulation applies: the compiled program is the compiler's for the source. -/
theorem wordsToNumbers_fixed : Fixed (progOf wordsToNumbersText) (genvOf wordsToNumbersText) :=
  fixed_of_check (by decide +kernel)

/-- `skijack` with its checker on accepts the ASCII text, and so does the front end's
    checker; the terms are the same (`Front.checkedWith_of_pass`). -/
theorem wordsToNumbers_checks : checkPass false wordsToNumbersText = true := by
  decide +kernel

/-- `skijack` with its checker on accepts the Unicode text, and so does the front end's
    checker; the terms are the same (`Front.checkedWith_of_pass`). -/
theorem wordsToNumbers_unicode_checks : checkPass true wordsToNumbersTextU = true := by
  decide +kernel

