/-- Every static quotation's body is valid over the table. -/
theorem table_valid : table.Valid := fun k hk => match k, hk with
      | 0, _ => rfl
      | 1, _ => rfl
      | 2, _ => rfl
      | 3, _ => rfl
      | 4, _ => rfl
      | _ + 5, h => absurd h (by show ¬ (_ + 5 < 5); omega)

scoped instance kit : Kit := table.kit
scoped instance elim : KitElim := table.kit_elim
