      | 0, _ => fun _ => oiter_sound (k := 10) rfl
      | 1, _ => fun _ => oiter_sound (k := 8) rfl
      | _ + 2, h => absurd h (by show ¬ (_ + 2 < 2); omega)
  QCons_elim := fun _ _ _ => oiter_sound (k := 38) rfl
