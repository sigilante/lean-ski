namespace HnfCert
open HnfS HnfProd HnfQ5

/-- **Hypothesis (A), kernel-checked.** -/
theorem minimalPairs : MinimalPairs :=
  minimalPairs_of_checks (all_claims K.ck_r) K.minOK_all K.shapesOK_all K.splitsOK_all
    (by rw [rootsCovered_eq]; exact K.roots_all)

/-- **Question 5 of *Dance of the Starlings*.**  A closed S-term is productive (its Böhm tree
is defined to every depth) iff its class in the 39-state automaton is not the rejecting class 37. -/
theorem q5 {t : Term} (ht : PureS t) : (∀ k, Pk k t) ↔ cls t ≠ 37 := q5_of_A minimalPairs ht

end HnfCert
