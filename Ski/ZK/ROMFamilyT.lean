import Ski.ZK.ROMFamily
import Ski.ZK.FSQueryPowT

/-!
# `n` statements of each circuit over the oracle's commitment, the queries and openings reading the tables

`ROMFamily` over `FSQueryPowT`: each first commitment the answer of its own
table (`comR`), its opening `pfR` with the distinguisher's queries `nxtT`
reading the four Fiat–Shamir tables, the later openings reading them too.
The view (`view4T`), the transfer at fixed tables (`rom4_stepT`, the
queries `nxtT` at those tables), and the bound moved to the real opening
with the simulated view reading the tables (`zkbT_rom`); then `n`
statements of each circuit (`sud_fs_open4_powDROMT`,
`wit_fs_open4_powDROMT`, `comp_fs_open4_powDROMT`).  `hout` and `hpq` stay
hypotheses on the ideal data (`comI`, `pfI`); `FSMultiOpen` discharges them
for openings reading at their own digit, with `nxtT` ignoring the tables.
One direction; `FSMultiT`'s limits hold.
-/

set_option autoImplicit false

namespace Circuit
open ZKF


/-- **`zkb_rom` with the simulated view reading the tables** (`ZKBT`): a bound at the ideal
    view and a transfer from the real view to it bound the real count, `Kt`
    times, the transfer's error `K` times. -/
theorem zkbT_rom {T X C V : Type} {K Kt ε et : Nat} {ST : (T → Nat) → Nat} {smR smI : (X → Nat) → Nat}
    {SC : (C → Nat) → Nat} {rvR rvI : T → X → V} {pg : T → C → X → T} {sv : T → C → X → V}
    (hz : ZKBT ST K smI SC rvI pg sv ε)
    (ht : ∀ E : T → V → Bool, Kt * ST (fun H => smR (fun x => indB (E H (rvR H x)))) ≤
      ST (fun H => smI (fun x => indB (E H (rvI H x)))) + et) (E : T → V → Bool) :
    Kt * K * ST (fun H => smR (fun x => indB (E H (rvR H x)))) ≤
      ST (fun H => SC (fun c => smI (fun x => indB (E (pg H c x) (sv H c x))))) + (ε + K * et) := by
  calc Kt * K * ST (fun H => smR (fun x => indB (E H (rvR H x))))
      = K * (Kt * ST (fun H => smR (fun x => indB (E H (rvR H x))))) := by rw [Nat.mul_comm Kt K, Nat.mul_assoc]
    _ ≤ K * (ST (fun H => smI (fun x => indB (E H (rvI H x)))) + et) := Nat.mul_le_mul_left _ (ht E)
    _ = K * ST (fun H => smI (fun x => indB (E H (rvI H x)))) + K * et := Nat.mul_add _ _ _
    _ ≤ _ := by
      rw [← Nat.add_assoc]
      exact Nat.add_le_add_right (hz E) _

/-- `view4` with the openings reading the tables `H` (`fs_open4_absT`'s
    `rvT` at `n1 = K`). -/
def view4T {PV PB D O1 P1 D2 O2 P2 D3 O3 P3 W : Type} (K NS2 K2 K3 K4 n2 : Nat)
    (φ : Nat → W → Nat) (rv : Nat → Nat → Nat → EF → EF → Nat → (Nat → Tup) → TViewN PV PB)
    (oz : TViewN PV PB → W) (ov1 : Nat → TViewN PV PB → Option O1) (main1 : (Nat → Tup) → Nat → D)
    (Com2 : D2 → Nat → Nat) (Pf2 : Nat → Nat → Nat → Nat → Nat → Nat → D2 → Nat → P2) (ov2 : Nat → TViewN PV PB → Option O2)
    (main2 : Nat → (Nat → Tup) → Nat → D2)
    (Com3 : D3 → Nat → Nat) (Pf3 : Nat → Nat → Nat → Nat → Nat → Nat → D3 → Nat → P3) (ov3 : Nat → TViewN PV PB → Option O3)
    (main3 : Nat → Nat → (Nat → Tup) → Nat → D3)
    (Com1 : D → Nat → Nat) (Pf1 : Nat → Nat → Nat → Nat → Nat → Nat → D → Nat → P1)
    (H : Nat × Nat × Nat × Nat) (x : Nat × Nat × Nat × (Nat → Tup)) :
    Nat × Nat × Nat × (Option P1 × Option (P2 × P3) × TViewN PV PB) :=
  let m1 := Com1 (main1 x.2.2.2 x.2.2.1) x.1
  let c1 := rget (Q4 * Q4) m1 H.1
  let m2 := m1 + K * Com2 (main2 c1 x.2.2.2 x.2.2.1) (x.2.1 % NS2)
  let c2 := rget K2 m2 H.2.1
  let m3 := m1 + K * comPair NS2 n2 Com2 Com3 (main2 c1 x.2.2.2 x.2.2.1, main3 c1 c2 x.2.2.2 x.2.2.1) x.2.1
  let c3 := rget K3 m3 H.2.2.1
  let c4 := rget K4 (φ m3 (oz (rv 0 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2))) H.2.2.2
  (m1, m2, m3,
   ((ov1 c4 (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)).map (fun _ => Pf1 c4 H.1 H.2.1 H.2.2.1 H.2.2.2 m3 (main1 x.2.2.2 x.2.2.1) x.1),
    (ovPair (ov2 c4) (ov3 c4) (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)).map
      (fun _ => pfPair NS2 (Pf2 c4 H.1 H.2.1 H.2.2.1 H.2.2.2 m3) (Pf3 c4 H.1 H.2.1 H.2.2.1 H.2.2.2 m3) (main2 c1 x.2.2.2 x.2.2.1, main3 c1 c2 x.2.2.2 x.2.2.1) x.2.1),
    rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2))

/-- **`rom4_step` with the queries and openings reading the tables**: at
    fixed tables the queries are `nxtT` there. -/
theorem rom4_stepT {PV PB D O Pq D2 O2 P2 D3 O3 P3 W : Type}
    {K NR m NSh NSo s k n NS2 NS3 K2 K3 K4 n2 : Nat} (hK : 0 < K)
    (φ : Nat → W → Nat) (rv : Nat → Nat → Nat → EF → EF → Nat → (Nat → Tup) → TViewN PV PB)
    (oz : TViewN PV PB → W)
    (pos : D → Nat → Nat → Nat) (hpos : ∀ d σo σh, pos d σo σh < n) (g : O → Nat → Pq)
    (hs : ∀ d σo v, sumTo NSh (fun σh => indB (decide (pos d σo σh = v))) ≤ s)
    (nxtT : Nat → Nat → Nat → Nat → Pq → Nat → List Nat → Nat) (op1 : Nat → D → O)
    (ov1 : Nat → TViewN PV PB → Option O) (main1 : (Nat → Tup) → Nat → D)
    (Com2 : D2 → Nat → Nat) (Pf2 : Nat → Nat → Nat → Nat → Nat → Nat → D2 → Nat → P2) (ov2 : Nat → TViewN PV PB → Option O2)
    (main2 : Nat → (Nat → Tup) → Nat → D2)
    (Com3 : D3 → Nat → Nat) (Pf3 : Nat → Nat → Nat → Nat → Nat → Nat → D3 → Nat → P3) (ov3 : Nat → TViewN PV PB → Option O3)
    (main3 : Nat → Nat → (Nat → Tup) → Nat → D3) (H : Nat × Nat × Nat × Nat)
    (G : Nat × Nat × Nat × (Option (Pq × List Nat) × Option (P2 × P3) × TViewN PV PB) → Bool) :
    K * sumTo (NSh * (NSo * K ^ n)) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (G (view4T K NS2 K2 K3 K4 n2 φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comR K NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfR K NSh NSo k pos (op1 c4) g (nxtT T1 T2 T3 T4)) H (σ1, σ, r, t))))))) ≤
    sumTo (NSh * (NSo * K ^ n) * K) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (G (view4T K NS2 K2 K3 K4 n2 φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comI K NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI K NSh NSo k pos (op1 c4) g (nxtT T1 T2 T3 T4)) H (σ1, σ, r, t))))))) +
      K * (NSo * (K ^ n * (s * k))) * (NS2 * NS3 * (NR * (Q4 ^ m * 1))) := by
  let c4f := fun (y : Nat × Nat × (Nat → Tup)) (c : Nat) =>
    let c1 := rget (Q4 * Q4) c H.1
    let c2 := rget K2 (c + K * Com2 (main2 c1 y.2.2 y.2.1) (y.1 % NS2)) H.2.1
    let mm3 := c + K * comPair NS2 n2 Com2 Com3 (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1
    let c3 := rget K3 mm3 H.2.2.1
    rget K4 (φ mm3 (oz (rv 0 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2))) H.2.2.2
  let ev := fun (y : Nat × Nat × (Nat → Tup)) (c : Nat) (pf : Pq × List Nat) =>
    let c1 := rget (Q4 * Q4) c H.1
    let mm2 := c + K * Com2 (main2 c1 y.2.2 y.2.1) (y.1 % NS2)
    let c2 := rget K2 mm2 H.2.1
    let mm3 := c + K * comPair NS2 n2 Com2 Com3 (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1
    let c3 := rget K3 mm3 H.2.2.1
    let c4 := c4f y c
    G (c, mm2, mm3,
      ((ov1 c4 (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2)).map (fun _ => pf),
       (ovPair (ov2 c4) (ov3 c4) (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2)).map
         (fun _ => pfPair NS2 (Pf2 c4 H.1 H.2.1 H.2.2.1 H.2.2.2 mm3) (Pf3 c4 H.1 H.2.1 H.2.2.1 H.2.2.2 mm3) (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1),
       rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2))
  have hso := smT_lin (NS2 * NS3) NR m
  have tr := transferRc_in (n := n) (NSh := NSh) (NSo := NSo) (s := s) (k := k) hK (smT (NS2 * NS3) NR m) hso
    pos hpos op1 g hs (nxtT H.1 H.2.1 H.2.2.1 H.2.2.2) (fun y => main1 y.2.2 y.2.1) c4f ev
  rw [hso, hso, smT_one] at tr
  exact tr


