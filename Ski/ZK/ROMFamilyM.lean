/-!
# `n` statements of each circuit over Merkle trees' leaves drawn from the oracle

`ROMFamily` with `fs_open4ROMM`'s commitment: each statement's first
commitment the answers of its leaves' table (`comM`, range `n1 = KA^L`),
its opening `pfM` showing the opened set `isOf ix c4`.  The ideal Merkle
commitment spreads fully, distinct leaves' answers being uniform
(`rgetL_spread`, `comM_spreadL`, `comMI_spreadL`), the transfer at fixed tables is
`rom4_stepM` (`transferMc_in`), and `n` statements of each circuit follow
(`sud_fs_open4_powDROMM`, `wit_fs_open4_powDROMM`, `comp_fs_open4_powDROMM`).
`hposO` stays a hypothesis, as in `ROMInstM`; one direction.
-/

set_option autoImplicit false

namespace Circuit
open ZKF

/-- **Distinct positions' answers are uniform**: `K^|ps|` times the tables
    at which they read any one value number at most `K^n` (`reprog_swapL`). -/
theorem rgetL_spread {K n : Nat} (hK : 0 < K) (ps : List Nat) (hnd : ps.Nodup) (hlt : ∀ p ∈ ps, p < n) (v : Nat) :
    K ^ ps.length * sumTo (K ^ n) (fun H => indB (decide (rgetL K ps H = v))) ≤ K ^ n := by
  have e := reprog_swapL (K := K) (n := n) hK ps hnd hlt (fun c _ => indB (decide (c = v)))
  simp only [sumTo_const] at e
  rw [sumTo_mul, e]
  calc K ^ n * sumTo (K ^ ps.length) (fun c => indB (decide (c = v))) ≤ K ^ n * 1 :=
        Nat.mul_le_mul_left _ (sumTo_indEq v _).1
    _ = K ^ n := Nat.mul_one _


theorem posAll_nodup {D : Type} (pos : D → Nat → Nat → Nat) (L NSl : Nat)
    (hdist : ∀ d l l' a b, l < L → l' < L → l ≠ l' → pos d l a ≠ pos d l' b) (d : D) (σh : Nat) :
    (posAll pos L NSl d σh).Nodup := by
  unfold posAll
  exact nodup_map_on _ _ (lr_nodup L) (fun a ha b hb hne => hdist d a b _ _ (mem_lr ha) (mem_lr hb) hne)

/-- **A Merkle tree's leaves' answers spread fully**: `K^L` times the salts at
    which `comM` takes any one value number at most `NSl^L K^n`. -/
theorem comM_spreadL {D : Type} {K n NSl L : Nat} (hK : 0 < K) (pos : D → Nat → Nat → Nat)
    (hdist : ∀ d l l' a b, l < L → l' < L → l ≠ l' → pos d l a ≠ pos d l' b)
    (hlt : ∀ d l a, l < L → pos d l a < n) (d : D) (v : Nat) :
    K ^ L * sumTo (NSl ^ L * K ^ n) (fun σ => indB (decide (comM K NSl L pos d σ = v))) ≤ NSl ^ L * K ^ n := by
  rw [Nat.mul_comm (NSl ^ L) (K ^ n), sum_digit (NSl ^ L) (K ^ n)]
  have hN : ∀ u, u < NSl ^ L → ∀ H, comM K NSl L pos d (u + NSl ^ L * H) = rgetL K (posAll pos L NSl d u) H :=
    fun u hu H => by unfold comM; rw [(digit_dec hu).1, (digit_dec hu).2]
  rw [sumTo_congr _ (fun H _ => sumTo_congr _ (fun u hu => by rw [hN u hu H])), sumTo_exch _ (NSl ^ L) (K ^ n),
    sumTo_mul]
  calc sumTo (NSl ^ L) (fun u => K ^ L * sumTo (K ^ n) (fun H => indB (decide (rgetL K (posAll pos L NSl d u) H = v))))
      ≤ sumTo (NSl ^ L) (fun _ => K ^ n) := sumTo_mono _ (fun u _ => by
        have h := rgetL_spread hK (posAll pos L NSl d u) (posAll_nodup pos L NSl hdist d u)
          (fun p hp => by
            unfold posAll at hp
            obtain ⟨l, hl, rfl⟩ := List.mem_map.1 hp
            exact hlt d l _ (mem_lr hl)) v
        rwa [posAll_length] at h)
    _ = K ^ n * NSl ^ L := by rw [sumTo_const, Nat.mul_comm]

/-- **The ideal Merkle commitment spreads fully**: at most `NSl^L K^n` of its
    salts give any one value, `1/K^L` of them (`comM_spreadL`). -/
theorem comMI_spreadL {D : Type} {K n NSl L : Nat} (hK : 0 < K) (pos : D → Nat → Nat → Nat)
    (hdist : ∀ d l l' a b, l < L → l' < L → l ≠ l' → pos d l a ≠ pos d l' b)
    (hlt : ∀ d l a, l < L → pos d l a < n) (d : D) (v : Nat) :
    sumTo (NSl ^ L * K ^ n * K ^ L) (fun σ => indB (decide (comMI K NSl L L pos d σ = v))) ≤ NSl ^ L * K ^ n := by
  rw [sum_digit (K ^ L) (NSl ^ L * K ^ n)]
  have e : ∀ σ, sumTo (K ^ L) (fun u => indB (decide (comMI K NSl L L pos d (u + K ^ L * σ) = v))) =
      K ^ L * indB (decide (comM K NSl L pos d σ = v)) := fun σ => by
    rw [sumTo_congr _ (fun u hu => by unfold comMI; rw [(digit_dec hu).1]), sumTo_const]
  rw [sumTo_congr _ (fun σ _ => e σ), ← sumTo_mul]
  exact comM_spreadL hK pos hdist hlt d v

/-- **`rom4_step` over a Merkle tree's leaves**: the transfer at fixed tables
    with `fs_open4ROMM`'s commitment (`transferMc_in`), `K = KA^L`. -/
theorem rom4_stepM {PV PB D O Pq D2 O2 P2 D3 O3 P3 W : Type}
    {K KA NR m NSl L s k n NS2 NS3 K2 K3 K4 n2 : Nat} (hKA : 0 < KA) (hN : 0 < NSl) (hKL : K = KA ^ L)
    (φ : Nat → W → Nat) (rv : Nat → Nat → Nat → EF → EF → Nat → (Nat → Tup) → TViewN PV PB)
    (oz : TViewN PV PB → W)
    (pos : D → Nat → Nat → Nat)
    (hdist : ∀ d l l' a b, l < L → l' < L → l ≠ l' → pos d l a ≠ pos d l' b)
    (hlt : ∀ d l a, l < L → pos d l a < n) (g : O → List Nat → Pq)
    (hs : ∀ d l v, sumTo NSl (fun x => indB (decide (pos d l x = v))) ≤ s)
    (nxt : Pq → Nat → List Nat → Nat) (op1 : Nat → D → O) (isOf : Nat → Nat → Bool)
    (ov1 : Nat → TViewN PV PB → Option O) (main1 : (Nat → Tup) → Nat → D)
    (Com2 : D2 → Nat → Nat) (Pf2 : Nat → D2 → Nat → P2) (ov2 : Nat → TViewN PV PB → Option O2)
    (main2 : Nat → (Nat → Tup) → Nat → D2)
    (Com3 : D3 → Nat → Nat) (Pf3 : Nat → D3 → Nat → P3) (ov3 : Nat → TViewN PV PB → Option O3)
    (main3 : Nat → Nat → (Nat → Tup) → Nat → D3) (H : Nat × Nat × Nat × Nat)
    (G : Nat × Nat × Nat × (Option (Pq × List Nat) × Option (P2 × P3) × TViewN PV PB) → Bool) :
    K * sumTo (NSl ^ L * KA ^ n) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (G (view4 K NS2 K2 K3 K4 n2 φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comM KA NSl L pos) (fun c4 => pfM KA NSl L k pos (isOf c4) (op1 c4) g nxt) H (σ1, σ, r, t))))))) ≤
    sumTo (NSl ^ L * KA ^ n * K) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (G (view4 K NS2 K2 K3 K4 n2 φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comMI KA NSl L L pos) (fun c4 => pfMI KA NSl L L k pos (isOf c4) (op1 c4) g nxt) H (σ1, σ, r, t))))))) +
      K * (L * (KA ^ n * (NSl ^ (L - 1) * (s * k)))) * (NS2 * NS3 * (NR * (Q4 ^ m * 1))) := by
  subst hKL
  let c4f := fun (y : Nat × Nat × (Nat → Tup)) (c : Nat) =>
    let c1 := rget (Q4 * Q4) c H.1
    let c2 := rget K2 (c + (KA ^ L) * Com2 (main2 c1 y.2.2 y.2.1) (y.1 % NS2)) H.2.1
    let mm3 := c + (KA ^ L) * comPair NS2 n2 Com2 Com3 (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1
    let c3 := rget K3 mm3 H.2.2.1
    rget K4 (φ mm3 (oz (rv 0 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2))) H.2.2.2
  let ev := fun (y : Nat × Nat × (Nat → Tup)) (c : Nat) (pf : Pq × List Nat) =>
    let c1 := rget (Q4 * Q4) c H.1
    let mm2 := c + (KA ^ L) * Com2 (main2 c1 y.2.2 y.2.1) (y.1 % NS2)
    let c2 := rget K2 mm2 H.2.1
    let mm3 := c + (KA ^ L) * comPair NS2 n2 Com2 Com3 (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1
    let c3 := rget K3 mm3 H.2.2.1
    let c4 := c4f y c
    G (c, mm2, mm3,
      ((ov1 c4 (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2)).map (fun _ => pf),
       (ovPair (ov2 c4) (ov3 c4) (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2)).map
         (fun _ => pfPair NS2 (Pf2 c4) (Pf3 c4) (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1),
       rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2))
  have hso := smT_lin (NS2 * NS3) NR m
  have tr := transferMc_in (n := n) (NSl := NSl) (L := L) (s := s) (k := k) hKA hN (smT (NS2 * NS3) NR m) hso
    pos hdist hlt hs isOf op1 g nxt (fun y => main1 y.2.2 y.2.1) c4f ev
  rw [hso, hso, smT_one] at tr
  exact tr


