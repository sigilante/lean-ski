import Ski.ZK.ROMFamily
import Ski.ZK.FSQueryAbsQ

/-!
# `n` statements of each circuit over the oracle's commitment, query answers shown on abort

`ROMFamily` with `fs_open4ROMQ`'s queries: each statement's first `kQ0`
queries chosen from its commitment alone and answered even where its proof
aborts, the rest reading its opening at the drawn challenge.  The view
showing those answers (`view4Q`), the transfer at fixed tables
(`rom4_stepQ`, `rom4_read4Q`), and the shown answers' hiding with the ideal
commitment (`pfIQ_hidesP`, `pfIQ_hides`); then `n` statements of each
circuit (`sud_fs_open4_powDROMQ`, `wit_fs_open4_powDROMQ`,
`comp_fs_open4_powDROMQ`, over `FSQueryAbsQ`).  One direction; as
`fs_openROMQ`, no query reads the Fiat–Shamir tables or the view.
-/

set_option autoImplicit false

namespace Circuit
open ZKF

/-- `view4` with the first opening's oldest answers (all but the newest
    `kd`) shown even where the proof aborts (`fs_open4_absQ`'s `rvT`). -/
def view4Q {PV PB D O1 Pq D2 O2 P2 D3 O3 P3 W : Type} (K NS2 K2 K3 K4 n2 kd : Nat)
    (φ : Nat → W → Nat) (rv : Nat → Nat → Nat → EF → EF → Nat → (Nat → Tup) → TViewN PV PB)
    (oz : TViewN PV PB → W) (ov1 : Nat → TViewN PV PB → Option O1) (main1 : (Nat → Tup) → Nat → D)
    (Com2 : D2 → Nat → Nat) (Pf2 : Nat → D2 → Nat → P2) (ov2 : Nat → TViewN PV PB → Option O2)
    (main2 : Nat → (Nat → Tup) → Nat → D2)
    (Com3 : D3 → Nat → Nat) (Pf3 : Nat → D3 → Nat → P3) (ov3 : Nat → TViewN PV PB → Option O3)
    (main3 : Nat → Nat → (Nat → Tup) → Nat → D3)
    (Com1 : D → Nat → Nat) (Pf1 : Nat → D → Nat → Pq × List Nat)
    (H : Nat × Nat × Nat × Nat) (x : Nat × Nat × Nat × (Nat → Tup)) :
    Nat × Nat × Nat × (List Nat × Option (Pq × List Nat) × Option (P2 × P3) × TViewN PV PB) :=
  let m1 := Com1 (main1 x.2.2.2 x.2.2.1) x.1
  let c1 := rget (Q4 * Q4) m1 H.1
  let m2 := m1 + K * Com2 (main2 c1 x.2.2.2 x.2.2.1) (x.2.1 % NS2)
  let c2 := rget K2 m2 H.2.1
  let m3 := m1 + K * comPair NS2 n2 Com2 Com3 (main2 c1 x.2.2.2 x.2.2.1, main3 c1 c2 x.2.2.2 x.2.2.1) x.2.1
  let c3 := rget K3 m3 H.2.2.1
  let c4 := rget K4 (φ m3 (oz (rv 0 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2))) H.2.2.2
  (m1, m2, m3,
   ((Pf1 c4 (main1 x.2.2.2 x.2.2.1) x.1).2.drop kd,
    (ov1 c4 (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)).map (fun _ => Pf1 c4 (main1 x.2.2.2 x.2.2.1) x.1),
    (ovPair (ov2 c4) (ov3 c4) (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)).map
      (fun _ => pfPair NS2 (Pf2 c4) (Pf3 c4) (main2 c1 x.2.2.2 x.2.2.1, main3 c1 c2 x.2.2.2 x.2.2.1) x.2.1),
    rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2))

/-- **`rom4_step` with the first opening's oldest answers shown on abort.** -/
theorem rom4_stepQ {PV PB D O Pq D2 O2 P2 D3 O3 P3 W : Type}
    {K NR m NSh NSo s k n NS2 NS3 K2 K3 K4 n2 kd : Nat} (hK : 0 < K)
    (φ : Nat → W → Nat) (rv : Nat → Nat → Nat → EF → EF → Nat → (Nat → Tup) → TViewN PV PB)
    (oz : TViewN PV PB → W)
    (pos : D → Nat → Nat → Nat) (hpos : ∀ d σo σh, pos d σo σh < n) (g : O → Nat → Pq)
    (hs : ∀ d σo v, sumTo NSh (fun σh => indB (decide (pos d σo σh = v))) ≤ s)
    (nxt : Pq → Nat → List Nat → Nat) (op1 : Nat → D → O)
    (ov1 : Nat → TViewN PV PB → Option O) (main1 : (Nat → Tup) → Nat → D)
    (Com2 : D2 → Nat → Nat) (Pf2 : Nat → D2 → Nat → P2) (ov2 : Nat → TViewN PV PB → Option O2)
    (main2 : Nat → (Nat → Tup) → Nat → D2)
    (Com3 : D3 → Nat → Nat) (Pf3 : Nat → D3 → Nat → P3) (ov3 : Nat → TViewN PV PB → Option O3)
    (main3 : Nat → Nat → (Nat → Tup) → Nat → D3) (H : Nat × Nat × Nat × Nat)
    (G : Nat × Nat × Nat × (List Nat × Option (Pq × List Nat) × Option (P2 × P3) × TViewN PV PB) → Bool) :
    K * sumTo (NSh * (NSo * K ^ n)) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (G (view4Q K NS2 K2 K3 K4 n2 kd φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comR K NSh NSo pos) (fun c4 => pfR K NSh NSo k pos (op1 c4) g nxt) H (σ1, σ, r, t))))))) ≤
    sumTo (NSh * (NSo * K ^ n) * K) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (G (view4Q K NS2 K2 K3 K4 n2 kd φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comI K NSh NSo pos) (fun c4 => pfI K NSh NSo k pos (op1 c4) g nxt) H (σ1, σ, r, t))))))) +
      K * (NSo * (K ^ n * (s * k))) * (NS2 * NS3 * (NR * (Q4 ^ m * 1))) := by
  let c4f := fun (y : Nat × Nat × (Nat → Tup)) (c : Nat) =>
    let c1 := rget (Q4 * Q4) c H.1
    let c2 := rget K2 (c + K * Com2 (main2 c1 y.2.2 y.2.1) (y.1 % NS2)) H.2.1
    let mm3 := c + K * comPair NS2 n2 Com2 Com3 (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1
    let c3 := rget K3 mm3 H.2.2.1
    rget K4 (φ mm3 (oz (rv 0 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2))) H.2.2.2
  let ev := fun (y : Nat × Nat × (Nat → Tup)) (c : Nat) (pf : Pq × List Nat) =>
    let c1 := rget (Q4 * Q4) c H.1
    let mm2 := c + K * Com2 (main2 c1 y.2.2 y.2.1) (y.1 % NS2)
    let c2 := rget K2 mm2 H.2.1
    let mm3 := c + K * comPair NS2 n2 Com2 Com3 (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1
    let c3 := rget K3 mm3 H.2.2.1
    let c4 := c4f y c
    G (c, mm2, mm3,
      (pf.2.drop kd, (ov1 c4 (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2)).map (fun _ => pf),
       (ovPair (ov2 c4) (ov3 c4) (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2)).map
         (fun _ => pfPair NS2 (Pf2 c4) (Pf3 c4) (main2 c1 y.2.2 y.2.1, main3 c1 c2 y.2.2 y.2.1) y.1),
       rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) y.2.1 y.2.2))
  have hso := smT_lin (NS2 * NS3) NR m
  have tr := transferRc_in (n := n) (NSh := NSh) (NSo := NSo) (s := s) (k := k) hK (smT (NS2 * NS3) NR m) hso
    pos hpos op1 g hs nxt (fun y => main1 y.2.2 y.2.1) c4f ev
  rw [hso, hso, smT_one] at tr
  exact tr

set_option maxRecDepth 100000 in
/-- **`rom4_stepQ` meets `read4_powDROM`'s transfer hypothesis**, the answers shown: the ideal
    four-round view is `read4`'s at the ideal commitment's messages. -/
theorem rom4_read4Q {PV PB D O Pq D2 O2 P2 D3 O3 P3 W : Type}
    {K NR m NSh NSo s k n NS2 NS3 K2 K3 K4 n2 kd : Nat} (hK : 0 < K)
    (φ : Nat → W → Nat) (rv : Nat → Nat → Nat → EF → EF → Nat → (Nat → Tup) → TViewN PV PB)
    (oz : TViewN PV PB → W)
    (pos : D → Nat → Nat → Nat) (hpos : ∀ d σo σh, pos d σo σh < n) (g : O → Nat → Pq)
    (hs : ∀ d σo v, sumTo NSh (fun σh => indB (decide (pos d σo σh = v))) ≤ s)
    (nxt : Pq → Nat → List Nat → Nat) (op1 : Nat → D → O)
    (ov1 : Nat → TViewN PV PB → Option O) (main1 : (Nat → Tup) → Nat → D)
    (Com2 : D2 → Nat → Nat) (Pf2 : Nat → D2 → Nat → P2) (ov2 : Nat → TViewN PV PB → Option O2)
    (main2 : Nat → (Nat → Tup) → Nat → D2)
    (Com3 : D3 → Nat → Nat) (Pf3 : Nat → D3 → Nat → P3) (ov3 : Nat → TViewN PV PB → Option O3)
    (main3 : Nat → Nat → (Nat → Tup) → Nat → D3) :
    let X := Nat × Nat × Nat × (Nat → Tup)
    let sm := fun (f : X → Nat) => sumTo (NSh * (NSo * K ^ n) * K) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t => f (σ1, σ, r, t)))))
    let smR := fun (f : X → Nat) => sumTo (NSh * (NSo * K ^ n)) (fun σ1 => sumTo (NS2 * NS3) (fun σ => sumTo NR (fun r => sumN m (fun t => f (σ1, σ, r, t)))))
    let Cmi := comI K NSh NSo pos
    let Pfi := fun (c4 : Nat) => pfI K NSh NSo k pos (op1 c4) g nxt
    let m1 := fun (x : X) => Cmi (main1 x.2.2.2 x.2.2.1) x.1
    let m2 := fun (c1 : Nat) (x : X) => m1 x + K * Com2 (main2 c1 x.2.2.2 x.2.2.1) (x.2.1 % NS2)
    let m3 := fun (c1 c2 : Nat) (x : X) =>
      m1 x + K * comPair NS2 n2 Com2 Com3 (main2 c1 x.2.2.2 x.2.2.1, main3 c1 c2 x.2.2.2 x.2.2.1) x.2.1
    let q := fun (c1 c2 c3 : Nat) (x : X) =>
      φ (m3 c1 c2 x) (oz (rv 0 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2))
    let out := fun (c4 c1 c2 c3 : Nat) (x : X) =>
      ((Pfi c4 (main1 x.2.2.2 x.2.2.1) x.1).2.drop kd,
       (ov1 c4 (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)).map (fun _ => Pfi c4 (main1 x.2.2.2 x.2.2.1) x.1),
       (ovPair (ov2 c4) (ov3 c4) (rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)).map
         (fun _ => pfPair NS2 (Pf2 c4) (Pf3 c4) (main2 c1 x.2.2.2 x.2.2.1, main3 c1 c2 x.2.2.2 x.2.2.1) x.2.1),
       rv c4 c2 c3 (efOf (c1 / Q4)) (efOf (c1 % Q4)) x.2.2.1 x.2.2.2)
    let vR := fun H (x : X) => view4Q K NS2 K2 K3 K4 n2 kd φ rv oz ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3
        (comR K NSh NSo pos) (fun c4 => pfR K NSh NSo k pos (op1 c4) g nxt) H x
    ∀ (H : Nat × Nat × Nat × Nat) (G : Nat × Nat × Nat × (List Nat × Option (Pq × List Nat) × Option (P2 × P3) × TViewN PV PB) → Bool), K * smR (fun x => indB (G (vR H x))) ≤
      sm (fun x => indB (G (read4 (Q4 * Q4) K2 K3 K4 m1 m2 m3 q out H x))) +
        K * (NSo * (K ^ n * (s * k))) * (NS2 * NS3 * (NR * (Q4 ^ m * 1))) := by
  intro X sm smR Cmi Pfi m1 m2 m3 q out vR H G
  exact rom4_stepQ (kd := kd) (NR := NR) (m := m) (NSh := NSh) (NSo := NSo) (s := s) (k := k) (n := n) (NS2 := NS2) (NS3 := NS3)
    (K2 := K2) (K3 := K3) (K4 := K4) (n2 := n2) hK φ rv oz pos hpos g hs nxt op1 ov1 main1 Com2 Pf2 ov2 main2 Com3 Pf3 ov3 main3 H G


/-- **The answers shown on abort hide with the ideal commitment**: the
    oldest `k0` answers of `nxtC k0 nxt0 nxtF`'s run, chosen from the
    commitment alone (`fs_open4ROMQ`'s `hc1`). -/
theorem pfIQ_hidesP {D O Pq : Type} {K n NSh NSo k0 k : Nat} (hK : 0 < K) (pos : D → Nat → Nat → Nat)
    (hpos : ∀ d σo σh, pos d σo σh < n) (op : D → O) (g : O → Nat → Pq) (nxt0 : Nat → List Nat → Nat)
    (nxtF : Pq → Nat → List Nat → Nat) :
    ComHidesP (NSh * (NSo * K ^ n) * K) (comI K NSh NSo pos)
      (fun d σ => (pfI K NSh NSo (k0 + k) pos op g (nxtC k0 nxt0 nxtF) d σ).2.drop k) := fun d d' F => by
  have hsplit : ∀ d σ, (pfI K NSh NSo (k0 + k) pos op g (nxtC k0 nxt0 nxtF) d σ).2.drop k =
      (pfI K NSh NSo k0 pos (fun _ => ()) (fun _ _ => ()) (fun _ => nxt0) d σ).2 :=
    fun d σ => runQ_split (K := K) nxt0 nxtF _ _ _ k
  simp only [hsplit]
  exact pfI_hides hK pos hpos (fun _ => ()) (fun _ _ => ()) (fun _ => nxt0) d d' rfl (fun c pf => F c pf.2)

/-- **The opening with the answers shown hides given its opened data**
    (`fs_open4ROMQ`'s `hp1`). -/
theorem pfIQ_hides {D O Pq : Type} {K n NSh NSo k0 k : Nat} (hK : 0 < K) (pos : D → Nat → Nat → Nat)
    (hpos : ∀ d σo σh, pos d σo σh < n) (op : D → O) (g : O → Nat → Pq) (nxt0 : Nat → List Nat → Nat)
    (nxtF : Pq → Nat → List Nat → Nat) :
    ComPfHides (NSh * (NSo * K ^ n) * K) (comI K NSh NSo pos)
      (fun d σ => ((pfI K NSh NSo (k0 + k) pos op g (nxtC k0 nxt0 nxtF) d σ).2.drop k,
        pfI K NSh NSo (k0 + k) pos op g (nxtC k0 nxt0 nxtF) d σ)) op :=
  fun d d' hop F => pfI_hides hK pos hpos op g (nxtC k0 nxt0 nxtF) d d' hop (fun c pf => F c (pf.2.drop k, pf))


