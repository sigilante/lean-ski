import Ski.ZK.FSMultiMixSud

/-!
# The programmed points' spread, whatever the challenger

`FSMultiMixSud`'s spread lemmas (`sudFS4T_hsp` and its kin) read the first
commitment back off the fourth table's index (`hdg : dg (φ m w) = m % n1`):
the challenger hashes the whole transcript, injectively in the first
commitment.  Plonky3's challenger is a duplex sponge, a compression of the
transcript that need not be injective.  Here the index is asked only to
spread over the first commitment's salt (`hφsp`).  The read-back implies
it (`hφsp_of_hdg`), and it is strictly weaker: `φ m w = (m % 2 + m / 2) % 2`
at `n1 = 2` meets it and admits no read-back.  A sponge meets it when the
index is its full state and the absorptions after the first commitment
permute the state; capacity collisions of the absorbed commitment enter
`δs`.  The proofs' spread lemmas (`sudFS4T_hspS`, `witFS4T_hspS`,
`compFS4T_hspS`) and the interleaved proofs (`sud_interleaveS`,
`wit_interleaveS`, `comp_interleaveS`) follow.  An adding sponge, its
full state the index, meets `hφsp` exactly (`SpongeSpread`).  `SpongeIndex` bounds
the overwrite sponge's spread at every table up to its meeting pairs, and
those pairs averaged over a uniform permutation.  Not shown: the step from
that average to `hφsp` at one table; the other composites' versions.
-/

set_option autoImplicit false

namespace Circuit
open ZKF

/-- **A spread bound summed over the other draws**: `spread_sum` for a value
    depending on every draw, spreading over the first salt `σ1`. -/
theorem spread_sumG {NS1 NS2 NR m δ : Nat} (G : Nat → Nat → Nat → (Nat → Tup) → Nat)
    (h : ∀ σ r t v, sumTo NS1 (fun σ1 => indB (decide (G σ1 σ r t = v))) ≤ δ) (v : Nat) :
    sumTo NS1 (fun σ1 => sumTo NS2 (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (decide (G σ1 σ r t = v)))))) ≤ NS2 * (NR * (Q4 ^ m * δ)) := by
  have e : sumTo NS1 (fun σ1 => sumTo NS2 (fun σ => sumTo NR (fun r => sumN m (fun t =>
      indB (decide (G σ1 σ r t = v)))))) =
      sumTo NS2 (fun σ => sumTo NR (fun r => sumN m (fun t => sumTo NS1 (fun σ1 =>
        indB (decide (G σ1 σ r t = v)))))) := by
    rw [sumTo_exch _ NS2 NS1]
    refine sumTo_congr _ (fun σ _ => ?_)
    rw [sumTo_exch _ NR NS1]
    refine sumTo_congr _ (fun r _ => ?_)
    exact sumTo_sumN m NS1 _
  rw [e]
  calc sumTo NS2 (fun σ => sumTo NR (fun r => sumN m (fun t => sumTo NS1 (fun σ1 =>
        indB (decide (G σ1 σ r t = v))))))
      ≤ sumTo NS2 (fun σ => sumTo NR (fun r => sumN m (fun t => δ))) :=
        sumTo_mono _ (fun σ _ => sumTo_mono _ (fun r _ => sumN_mono m (fun t => h _ _ _ _)))
    _ = _ := by rw [sumTo_congr _ (fun σ _ => sumTo_congr _ (fun r _ => sumN_const m δ)), sumTo_congr _
        (fun σ _ => sumTo_const _ NR), sumTo_const]

/-- **The full-transcript read-back meets `hφsp`**: where `dg (φ m w)` reads
    the first commitment back, `φ` spreads over the salt as the commitment
    does. -/
theorem hφsp_of_hdg {D W : Type} {NS1 n1 δs : Nat} (Com1 : D → Nat → Nat) (φ : Nat → W → Nat) (dg : Nat → Nat)
    (hdg : ∀ m w, dg (φ m w) = m % n1) (hr1 : ∀ d σ, Com1 d σ < n1)
    (hsp1 : ∀ d v, sumTo NS1 (fun σ => indB (decide (Com1 d σ = v))) ≤ δs) :
    ∀ d rest w v, sumTo NS1 (fun σ1 => indB (decide (φ (Com1 d σ1 + n1 * rest) w = v))) ≤ δs := by
  intro d rest w v
  refine Nat.le_trans (sumTo_mono _ (fun σ1 _ => ?_)) (hsp1 d (dg v))
  cases e : decide (φ (Com1 d σ1 + n1 * rest) w = v)
  · exact Nat.zero_le _
  · have hv : φ (Com1 d σ1 + n1 * rest) w = v := of_decide_eq_true e
    have : Com1 d σ1 = dg v := by
      rw [← hv, hdg, Nat.add_mul_mod_self_left, Nat.mod_eq_of_lt (hr1 _ _)]
    rw [decide_eq_true this]; exact Nat.le_refl _

/-- The first three coordinates read the first commitment back without the
    fourth table. -/
theorem coord_digit012 {n1 : Nat} (p : Nat × Nat × Nat × Nat)
    (h1 : p.2.1 % n1 = p.1) (h2 : p.2.2.1 % n1 = p.1) {tab v : Nat} (ht : tab < 3)
    (e : coord4 tab p = v) : p.1 = digitOf n1 id tab v := by
  match tab, ht, e with
  | 0, _, e => exact e
  | 1, _, e => change p.2.1 = v at e; show p.1 = v % n1; rw [← e, h1]
  | 2, _, e => change p.2.2.1 = v at e; show p.1 = v % n1; rw [← e, h2]

