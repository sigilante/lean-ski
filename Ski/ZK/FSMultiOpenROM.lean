/-- **`sudFS4T_hout` over the oracle's commitment, the distinguisher's
    queries reading the Fiat–Shamir tables at the commitment value's digit**
    (`nxtRd`): the first opening `pfI` unchanged where the programming misses
    the first message's digit (`pfI_nxtRd`), the others by `RdOK`. -/
theorem sudFS4T_houtROM {V Wv P2 P3 Pq O Wq : Type} (off : EF → String → EF) (puzzle : List Nat) (A : List Cell) (k : Nat) (row : Nat → Air.Row) (tP : Nat) (S16 : Nat → List F) (S10 : Nat → List F) (SP : Nat → List F) (qv : EF → EF → List EF → F → List F → List F → List EF) (wm : Nat → List (EF → EF → List F)) (wc : Nat → List (EF → EF → List F)) (ww : Nat → List (EF → EF → List F)) (wp : Nat → List (EF → EF → List F)) (K2 : Nat) (K4 : Nat) (φ : Nat → Option (List (List (List EF)) × List (List (List (List EF))) × List (List (List EF))) → Nat) (N4 : Nat) (ncw : Nat) (αd : Nat → EF) (B4 : Nat) (fri : Nat → EF → EF → List (EF → EF) → V) (NR2 : Nat) (Rb : Nat → EF → EF → Nat → List (EF → EF)) (Ro : Nat → EF → EF → Nat → Wv) (NS1 : Nat) (NS2 : Nat) (NS3 : Nat) (n1 : Nat) (n2 : Nat) (n3 : Nat) (Com2 : List (List (List F)) → Nat → Nat) (Pf2 : Nat → Nat → Nat → Nat → Nat → Nat → List (List (List F)) → Nat → P2) (Com3 : List (List (List (List F))) × List (List (List F)) → Nat → Nat) (Pf3 : Nat → Nat → Nat → Nat → Nat → Nat → List (List (List (List F))) × List (List (List F)) → Nat → P3) (hqr : Nat × Nat × Nat × Nat → Nat × Nat × Nat × Nat → Nat × Nat × Nat × (Nat → Tup) → Bool)
    {NSh NSo kQ kk : Nat} (hn1 : 0 < n1) (pos : List (List (List F)) → Nat → Nat → Nat)
    (op1 : Nat → List (List (List F)) → O) (g : O → Nat → Pq) (φq : Nat → Wq → Nat)
    (st : Pq → Nat → List Nat → List Nat → Nat × Nat × Wq) (F : Pq → Nat → List Nat → List Nat → Nat)
    (dg : Nat → Nat) (hdg : ∀ m w, dg (φq m w) = m % n1)
    (hR2 : RdOK (Q4 * Q4) K2 Q4 K4 n1 dg Pf2) (hR3 : RdOK (Q4 * Q4) K2 Q4 K4 n1 dg Pf3) (hK2 : 0 < K2) (hK4 : 0 < K4) :
    ∀ H p a c4 c1 c2 c3 xd, a.1 < Q4 * Q4 ∧ a.2.1 < K2 ∧ a.2.2.1 < Q4 ∧ a.2.2.2 < K4 →
      hqD n1 dg (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).m1 H p xd = false →
      (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).out (prog4 (Q4 * Q4) K2 Q4 K4 H p a) c4 c1 c2 c3 xd = (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).out H c4 c1 c2 c3 xd := by
  intro H p a c4 c1 c2 c3 xd ha hq
  simp only [hqD, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hq
  have hm1 : (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).m1 xd < n1 := Nat.mod_lt _ hn1
  have hM : (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).m3 c1 c2 xd % n1 = (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).m1 xd :=
    (Nat.add_mul_mod_self_left _ _ _).trans (Nat.mod_eq_of_lt hm1)
  have hq' := hq
  rw [← hM] at hq'
  have e2 := hR2 c4 H p a _ ha hq'.1.1.1 hq'.1.1.2 hq'.1.2 hq'.2
  have e3 := hR3 c4 H p a _ ha hq'.1.1.1 hq'.1.1.2 hq'.1.2 hq'.2
  have hc : (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).m1 xd % n1 = (@sudFS4T V Wv (Pq × List Nat) P2 P3 off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 (comI n1 NSh NSo pos) (fun c4 T1 T2 T3 T4 _ => pfI n1 NSh NSo kQ pos (op1 c4) g (nxtRd (Q4 * Q4) K2 Q4 K4 n1 kk φq st F T1 T2 T3 T4)) Com2 Pf2 Com3 Pf3 hqr).m1 xd := Nat.mod_eq_of_lt hm1
  rw [← hc] at hq
  have e1 := pfI_nxtRd (kQ := kQ) (kk := kk) (Nat.mul_pos Q4_pos Q4_pos) hK2 Q4_pos hK4 dg φq hdg st F pos (op1 c4) g H p a ha
    _ _ hq.1.1.1 hq.1.1.2 hq.1.2 hq.2
  dsimp only [sudFS4T] at e1 e2 e3 ⊢
  rw [e1, e2, e3]


