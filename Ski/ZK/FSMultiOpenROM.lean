import Ski.ZK.FSMultiOpen

/-!
# The distinguisher's commitment-table queries reading the Fiat–Shamir tables

`FSMultiOpen`'s oracle-commitment theorems (`*_fs_open4_powDROMR`) ask the
distinguisher's queries `nxtT` into the commitment's table to ignore the
Fiat–Shamir tables (`hnx`).  `runQ` calls the strategy only at the
commitment's value `c`, the first message, so a strategy reading the
Fiat–Shamir tables at points carrying `c` as low digit (`nxtRd`, `kk` reads
by `runR4` at `c % n1`) is unchanged by a programming whose coordinates all
miss that digit (`nxtRd_prog`, `pfI_nxtRd`, by `runQ_congr`).  The ideal
opening's commitment value is the first message, so `hout` holds under the
digit flag (`sudFS4T_houtROM`), and the Sudoku statements over the oracle's
commitments keep their bound with the queries reading the Fiat–Shamir
tables there (`sud_fs_open4_powDROMQ`, `sud_fs_open4_powDROMR` without
`hnx`).  Not shown: queries reading the Fiat–Shamir tables elsewhere; the
hidden-term and composed circuits.
-/

set_option autoImplicit false

namespace Circuit
open ZKF

/-- A commitment-table query strategy reading the Fiat–Shamir tables at the
    commitment value's digit: `kk` reads by `runR4` at `c % n1`, the strategy
    `st` and the query `F` any function of the opening, the value, the
    commitment-table answers and the reads. -/
def nxtRd {P W : Type} (K1 K2 K3 K4 n1 kk : Nat) (φq : Nat → W → Nat)
    (st : P → Nat → List Nat → List Nat → Nat × Nat × W) (F : P → Nat → List Nat → List Nat → Nat)
    (T1 T2 T3 T4 : Nat) (pq : P) (c : Nat) (ans : List Nat) : Nat :=
  F pq c ans (runR4 K1 K2 K3 K4 n1 (c % n1) φq (st pq c ans) (T1, T2, T3, T4) kk)

theorem nxtRd_eq_pfRd {P W : Type} (K1 K2 K3 K4 n1 kk : Nat) (φq : Nat → W → Nat)
    (st : P → Nat → List Nat → List Nat → Nat × Nat × W) (F : P → Nat → List Nat → List Nat → Nat)
    (T1 T2 T3 T4 : Nat) (pq : P) (c : Nat) (ans : List Nat) :
    nxtRd K1 K2 K3 K4 n1 kk φq st F T1 T2 T3 T4 pq c ans =
      pfRd K1 K2 K3 K4 n1 kk φq (fun _ M a _ => st pq M a) (fun _ M a _ rs => F pq M a rs) 0 T1 T2 T3 T4 c ans 0 :=
  rfl

/-- **The strategy is unchanged at `c` by a programming missing `c`'s
    digit.** -/
theorem nxtRd_prog {P W : Type} {K1 K2 K3 K4 n1 kk : Nat} (h1 : 0 < K1) (h2 : 0 < K2) (h3 : 0 < K3) (h4 : 0 < K4)
    (dg : Nat → Nat) (φq : Nat → W → Nat) (hdg : ∀ m w, dg (φq m w) = m % n1)
    (st : P → Nat → List Nat → List Nat → Nat × Nat × W) (F : P → Nat → List Nat → List Nat → Nat)
    (H p a : Nat × Nat × Nat × Nat) (ha : a.1 < K1 ∧ a.2.1 < K2 ∧ a.2.2.1 < K3 ∧ a.2.2.2 < K4) (pq : P) (c : Nat)
    (q1 : p.1 % n1 ≠ c % n1) (q2 : p.2.1 % n1 ≠ c % n1) (q3 : p.2.2.1 % n1 ≠ c % n1) (q4 : dg p.2.2.2 ≠ c % n1) :
    nxtRd K1 K2 K3 K4 n1 kk φq st F (prog4 K1 K2 K3 K4 H p a).1 (prog4 K1 K2 K3 K4 H p a).2.1
      (prog4 K1 K2 K3 K4 H p a).2.2.1 (prog4 K1 K2 K3 K4 H p a).2.2.2 pq c =
      nxtRd K1 K2 K3 K4 n1 kk φq st F H.1 H.2.1 H.2.2.1 H.2.2.2 pq c := by
  funext ans
  rw [nxtRd_eq_pfRd, nxtRd_eq_pfRd]
  have := pfRd_ok (k := kk) h1 h2 h3 h4 dg φq hdg (fun _ M a _ => st pq M a) (fun _ M a _ rs => F pq M a rs)
    0 H p a c ha q1 q2 q3 q4
  exact congrFun (congrFun this ans) 0

/-- **The ideal opening with such a strategy is unchanged by a programming
    missing its commitment value's digit.** -/
theorem pfI_nxtRd {D O P W : Type} {K1 K2 K3 K4 n1 kk K NSh NSo kQ : Nat} (h1 : 0 < K1) (h2 : 0 < K2) (h3 : 0 < K3)
    (h4 : 0 < K4) (dg : Nat → Nat) (φq : Nat → W → Nat) (hdg : ∀ m w, dg (φq m w) = m % n1)
    (st : P → Nat → List Nat → List Nat → Nat × Nat × W) (F : P → Nat → List Nat → List Nat → Nat)
    (pos : D → Nat → Nat → Nat) (op : D → O) (g : O → Nat → P)
    (H p a : Nat × Nat × Nat × Nat) (ha : a.1 < K1 ∧ a.2.1 < K2 ∧ a.2.2.1 < K3 ∧ a.2.2.2 < K4) (d : D) (σ : Nat)
    (q1 : p.1 % n1 ≠ comI K NSh NSo pos d σ % n1) (q2 : p.2.1 % n1 ≠ comI K NSh NSo pos d σ % n1)
    (q3 : p.2.2.1 % n1 ≠ comI K NSh NSo pos d σ % n1) (q4 : dg p.2.2.2 ≠ comI K NSh NSo pos d σ % n1) :
    pfI K NSh NSo kQ pos op g (nxtRd K1 K2 K3 K4 n1 kk φq st F (prog4 K1 K2 K3 K4 H p a).1
      (prog4 K1 K2 K3 K4 H p a).2.1 (prog4 K1 K2 K3 K4 H p a).2.2.1 (prog4 K1 K2 K3 K4 H p a).2.2.2) d σ =
      pfI K NSh NSo kQ pos op g (nxtRd K1 K2 K3 K4 n1 kk φq st F H.1 H.2.1 H.2.2.1 H.2.2.2) d σ := by
  unfold pfI
  congr 1
  exact (runQ_congr (fun l => congrFun (nxtRd_prog h1 h2 h3 h4 dg φq hdg st F H p a ha _ _ q1 q2 q3 q4) l) kQ _).1

