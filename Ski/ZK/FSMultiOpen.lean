/-- **The sud openings, reading only at the reader's digit, leave its output
    unchanged by a programming whose coordinates all miss that digit**
    (`hqD`): `hout` for openings meeting `RdOK`. -/
theorem sudFS4T_hout {V Wv P1 P2 P3 : Type} (off : EF → String → EF) (puzzle : List Nat) (A : List Cell) (k : Nat) (row : Nat → Air.Row) (tP : Nat) (S16 : Nat → List F) (S10 : Nat → List F) (SP : Nat → List F) (qv : EF → EF → List EF → F → List F → List F → List EF) (wm : Nat → List (EF → EF → List F)) (wc : Nat → List (EF → EF → List F)) (ww : Nat → List (EF → EF → List F)) (wp : Nat → List (EF → EF → List F)) (K2 : Nat) (K4 : Nat) (φ : Nat → Option (List (List (List EF)) × List (List (List (List EF))) × List (List (List EF))) → Nat) (N4 : Nat) (ncw : Nat) (αd : Nat → EF) (B4 : Nat) (fri : Nat → EF → EF → List (EF → EF) → V) (NR2 : Nat) (Rb : Nat → EF → EF → Nat → List (EF → EF)) (Ro : Nat → EF → EF → Nat → Wv) (NS1 : Nat) (NS2 : Nat) (NS3 : Nat) (n1 : Nat) (n2 : Nat) (n3 : Nat) (Com1 : List (List (List F)) → Nat → Nat) (Pf1 : Nat → Nat → Nat → Nat → Nat → Nat → List (List (List F)) → Nat → P1) (Com2 : List (List (List F)) → Nat → Nat) (Pf2 : Nat → Nat → Nat → Nat → Nat → Nat → List (List (List F)) → Nat → P2) (Com3 : List (List (List (List F))) × List (List (List F)) → Nat → Nat) (Pf3 : Nat → Nat → Nat → Nat → Nat → Nat → List (List (List (List F))) × List (List (List F)) → Nat → P3) (hqr : Nat × Nat × Nat × Nat → Nat × Nat × Nat × Nat → Nat × Nat × Nat × (Nat → Tup) → Bool) (dg : Nat → Nat)
    (hr1 : ∀ d σ, Com1 d σ < n1) (hR1 : RdOK (Q4 * Q4) K2 Q4 K4 n1 dg Pf1) (hR2 : RdOK (Q4 * Q4) K2 Q4 K4 n1 dg Pf2)
    (hR3 : RdOK (Q4 * Q4) K2 Q4 K4 n1 dg Pf3) :
    ∀ H p a c4 c1 c2 c3 xd, a.1 < Q4 * Q4 ∧ a.2.1 < K2 ∧ a.2.2.1 < Q4 ∧ a.2.2.2 < K4 →
      hqD n1 dg (sudFS4T off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 Com1 Pf1 Com2 Pf2 Com3 Pf3 hqr).m1 H p xd = false →
      (sudFS4T off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 Com1 Pf1 Com2 Pf2 Com3 Pf3 hqr).out (prog4 (Q4 * Q4) K2 Q4 K4 H p a) c4 c1 c2 c3 xd = (sudFS4T off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 Com1 Pf1 Com2 Pf2 Com3 Pf3 hqr).out H c4 c1 c2 c3 xd := by
  intro H p a c4 c1 c2 c3 xd ha hq
  simp only [hqD, Bool.or_eq_false_iff, decide_eq_false_iff_not] at hq
  have hM : (sudFS4T off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 Com1 Pf1 Com2 Pf2 Com3 Pf3 hqr).m3 c1 c2 xd % n1 = (sudFS4T off puzzle A k row tP S16 S10 SP qv wm wc ww wp K2 K4 φ N4 ncw αd B4 fri NR2 Rb Ro NS1 NS2 NS3 n1 n2 n3 Com1 Pf1 Com2 Pf2 Com3 Pf3 hqr).m1 xd :=
    (Nat.add_mul_mod_self_left _ _ _).trans (Nat.mod_eq_of_lt (hr1 _ _))
  rw [← hM] at hq
  have e1 := hR1 c4 H p a _ ha hq.1.1.1 hq.1.1.2 hq.1.2 hq.2
  have e2 := hR2 c4 H p a _ ha hq.1.1.1 hq.1.1.2 hq.1.2 hq.2
  have e3 := hR3 c4 H p a _ ha hq.1.1.1 hq.1.1.2 hq.1.2 hq.2
  dsimp only [sudFS4T] at e1 e2 e3 ⊢
  rw [e1, e2, e3]

