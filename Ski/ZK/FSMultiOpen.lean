import Ski.ZK.ROMFamilyT
import Ski.ZK.FSMultiReads

/-!
# The circuits' openings reading the tables at their own digit

`FSQueryPowT`'s `n`-statement theorems take an output's table reads as
hypotheses (`hout`, `hpq`).  Each opening now receives the third message
`M` (`fs_open4T`), whose low digit mod `n1` is the first commitment, so
an opening can read where the read class of `FSMultiReads` reads.  Here
the hypotheses are discharged for openings that read only there.

An opening meets `RdOK` when a programming whose four coordinates all miss
the digit `M % n1` leaves it unchanged; a fourth-table coordinate's digit
is read back by `dg`.  The adaptive reader `pfRd` meets it (`pfRd_ok`):
`k` reads by `runR4` at `M % n1`, the strategy and the result any
function of the fourth challenge, the message, the data and the salt.
The output's reads are flagged by the digit flag `hqD`, which ignores the
tables and flags a programmed point when any coordinate carries the
reader's first commitment, read there or not.  `hout` follows (`sudFS4T_hout`,
`witFS4T_hout`, `compFS4T_hout`), and `hpq` holds at every simulated point
(`hqD_hpq`).  The `n`-statement bounds then carry no `hout` or `hpq`, the
openings' reads entering as `RdOK` (`sud_fs_open4_powDR`, `wit_fs_open4_powDR`, `comp_fs_open4_powDR`); `hdg`
(`dg (φ ix m w) = m % n1`) replaces `hφs`, implies it, and follows from it
classically.  The error is
`FSQueryPowT`'s: the collision term counts first-commitment collisions
(`δs`), not reads.  Over the oracle's commitments
(`sud_fs_open4_powDROMR`, `wit_fs_open4_powDROMR`,
`comp_fs_open4_powDROMR`) the first opening meets `RdOK` when the
distinguisher's queries `nxtT` into the commitment's table ignore the
Fiat–Shamir tables (`hnx`, `rdOK_nxt`).

Assumed: each opening hides at every message `M` and every choice of
tables against `op? c4` alone (`hp?`), so an opening that reveals values at
positions drawn from `M` or the tables meets `hp?` only when `op? c4`
already fixes them; and `hdg` presumes that every oracle input carries the
first commitment's digit, as a Fiat–Shamir hashing the whole transcript
prefix does.  Plonky3's duplex challenger squeezes from a sponge state that
does not expose that digit, so `hdg` and `RdOK` model the full-transcript
hash, not the duplex sponge.

Not shown: that Plonky3's openings read this way, which needs FRI's
folding challenges drawn at points carrying the first commitment's digit.
`FSMultiOpenROM` covers `nxtT` queries that read the Fiat–Shamir tables,
and `FSMultiMixSud` covers query phases between proofs (`sud_interleave`).
One direction; `FSMultiT`'s limits hold.
-/

set_option autoImplicit false

namespace Circuit
open ZKF

/-- A programmed point is flagged when any coordinate carries the reader's
    first commitment as low digit mod `n1`; the fourth coordinate's digit
    read by `dg`. -/
def hqD {X : Type} (n1 : Nat) (dg : Nat → Nat) (m1 : X → Nat) (_ : Nat × Nat × Nat × Nat)
    (p : Nat × Nat × Nat × Nat) (x : X) : Bool :=
  decide (p.1 % n1 = m1 x) || decide (p.2.1 % n1 = m1 x) || decide (p.2.2.1 % n1 = m1 x) ||
    decide (dg p.2.2.2 = m1 x)

/-- An opening reading the tables only at the digit `M % n1`: unchanged by
    an in-range programming whose four coordinates all miss it. -/
def RdOK {D P : Type} (K1 K2 K3 K4 n1 : Nat) (dg : Nat → Nat)
    (Pf : Nat → Nat → Nat → Nat → Nat → Nat → D → Nat → P) : Prop :=
  ∀ c4 H p a M, a.1 < K1 ∧ a.2.1 < K2 ∧ a.2.2.1 < K3 ∧ a.2.2.2 < K4 →
    p.1 % n1 ≠ M % n1 → p.2.1 % n1 ≠ M % n1 → p.2.2.1 % n1 ≠ M % n1 → dg p.2.2.2 ≠ M % n1 →
    Pf c4 (prog4 K1 K2 K3 K4 H p a).1 (prog4 K1 K2 K3 K4 H p a).2.1 (prog4 K1 K2 K3 K4 H p a).2.2.1
      (prog4 K1 K2 K3 K4 H p a).2.2.2 M = Pf c4 H.1 H.2.1 H.2.2.1 H.2.2.2 M

/-- An opening reading the four tables adaptively at its digit: `k` reads
    by `runR4` at `M % n1`, the strategy `nxt` and the result `G` any
    function of the fourth challenge, the message, the data and the salt. -/
def pfRd {D P W : Type} (K1 K2 K3 K4 n1 k : Nat) (φ : Nat → W → Nat)
    (nxt : Nat → Nat → D → Nat → List Nat → Nat × Nat × W) (G : Nat → Nat → D → Nat → List Nat → P)
    (c4 T1 T2 T3 T4 M : Nat) (d : D) (σ : Nat) : P :=
  G c4 M d σ (runR4 K1 K2 K3 K4 n1 (M % n1) φ (nxt c4 M d σ) (T1, T2, T3, T4) k)

theorem digit_mod (n1 M j : Nat) : (M % n1 + n1 * j) % n1 = M % n1 := by
  rw [Nat.add_mul_mod_self_left, Nat.mod_mod]

/-- **`pfRd` reads only at its digit**, given that `dg` reads back the
    digit of the fourth-table hash. -/
theorem pfRd_ok {D P W : Type} {K1 K2 K3 K4 n1 k : Nat} (h1 : 0 < K1) (h2 : 0 < K2) (h3 : 0 < K3) (h4 : 0 < K4)
    (dg : Nat → Nat) (φ : Nat → W → Nat) (hdg : ∀ m w, dg (φ m w) = m % n1)
    (nxt : Nat → Nat → D → Nat → List Nat → Nat × Nat × W) (G : Nat → Nat → D → Nat → List Nat → P) :
    RdOK K1 K2 K3 K4 n1 dg (pfRd K1 K2 K3 K4 n1 k φ nxt G) := by
  intro c4 H p a M ha q1 q2 q3 q4
  funext d σ
  unfold pfRd
  congr 1
  refine runR4_prog h1 h2 h3 h4 φ (nxt c4 M d σ) H p a ha k (fun r _ e => ?_)
  obtain ⟨i, j, w⟩ := r
  match i, e with
  | 0, e =>
    change p.1 = M % n1 + n1 * j at e
    exact q1 (by rw [e, digit_mod])
  | 1, e =>
    change p.2.1 = M % n1 + n1 * j at e
    exact q2 (by rw [e, digit_mod])
  | 2, e =>
    change p.2.2.1 = M % n1 + n1 * j at e
    exact q3 (by rw [e, digit_mod])
  | i + 3, e =>
    change p.2.2.2 = φ (M % n1 + n1 * j) w at e
    exact q4 (by rw [e, hdg, digit_mod])

/-- An opening whose tables enter only through a query strategy that
    ignores them meets `RdOK`: the oracle commitment's opening with the
    distinguisher's queries `nx` chosen without the Fiat–Shamir tables. -/
theorem rdOK_nxt {D P Q : Type} {K1 K2 K3 K4 n1 : Nat} (dg : Nat → Nat) (F : Nat → Q → D → Nat → P)
    (nx : Nat → Nat → Nat → Nat → Q) (hnx : ∀ T1 T2 T3 T4, nx T1 T2 T3 T4 = nx 0 0 0 0) :
    RdOK K1 K2 K3 K4 n1 dg (fun c4 T1 T2 T3 T4 _ => F c4 (nx T1 T2 T3 T4)) := by
  intro c4 H p a M _ _ _ _ _
  show F c4 (nx _ _ _ _) = F c4 (nx _ _ _ _)
  rw [hnx (prog4 K1 K2 K3 K4 H p a).1, hnx H.1]

/-- **`hpq` for the digit flag**: a flagged point whose coordinates all
    carry its first coordinate as digit carries the reader's first
    commitment. -/
theorem hqD_hpq {X : Type} {n1 : Nat} (dg : Nat → Nat) (m1 : X → Nat) (H p : Nat × Nat × Nat × Nat) (x : X)
    (h0 : p.1 < n1) (h2 : p.2.1 % n1 = p.1) (h3 : p.2.2.1 % n1 = p.1) (h4 : dg p.2.2.2 = p.1) :
    hqD n1 dg m1 H p x = true → m1 x = p.1 := by
  simp only [hqD, Bool.or_eq_true, decide_eq_true_eq]
  rintro (((h | h) | h) | h)
  · rw [← h, Nat.mod_eq_of_lt h0]
  · rw [← h, h2]
  · rw [← h, h3]
  · rw [← h, h4]

