import Ski.Full
import Ski.Conv
import Ski.TowerFin
open Term

/-!
# The tower of models (S6: Lemma 7, Theorem 1, Corollary 2)

Mechanization of Section 5 of the S6 paper (`s6-prefix-regularity/main.tex`): the decidable
syntactic congruence of the full observable and its quotient model (Lemma 7), Prefix Regularity
at every depth (Theorem 1), and decidability of realizable prefixes (Corollary 2).

* **Bridge** (`obsF_iff_hasObs`, `obsF_conv`, `cong_of_conv`): `Full.ObsF` is `Conv.HasObs` over
  the valuation of the model, so Lemma 3 (`Conv.obs_conv`) applies to it; the syntactic congruence
  `Cong` of `ObsF` contains conversion.
* **Finite models as tables** (`TModel`): carrier `Fin m`, application a function, a homomorphism
  `φ` to S1's blocks.  `TModel.periodic`: the constants of S6, Section 4 exist for every table:
  `N = m² + m + 10`, `p = (m² + m)!` (pigeonhole, `TowerFin.iter_period`).
* **Finite index** (`finite_index`): among any `sgB T + 1` closed S-terms two are congruent,
  `sgB T = sigBound m (N + p) 78`.
* **The observable as a function** (`obsFn`, `obsFn_iff`), from `Full.headEnd`.
* **Lemma 7** (`lemma7 : (T : TModel) → Quo T`): the quotient of closed S-terms by `Cong` as an
  explicit table `Q`, generated by `S` (`rep`, `rep_val`), with `syn`: `Q.val t = Q.val t'` iff
  `Cong t t'`; `obs_spec`: the fold computes `ObsF`; `h`: the homomorphism to `T`.  `decCong`:
  the congruence is decidable.
* **The reduction** (`reduction`, `reduction_hom`): `π_{d+1}(t) = outF o_d (o_{d−1} ∘ h_d) (O(t))`.
* **Theorem 1** (`levels`, `M`, `o`, `hom`, `prefix_regularity`, `theorem_one`), and
  **Corollary 2** (`realizable`, `realizable_iff`, the `Decidable` instance).

Construction of Lemma 7 (differs from the paper's `E_i` over terms of bounded depth; same
ingredients).  (1) `TowerFin.closure`: close `{S}` under application modulo the level-78 signature
`sgc` of Theorem 6 (`Full.sig`, at most `sgB T` values, so the closure stops: pigeonhole).  This
gives a finite algebra `alg T` on representatives whose fold `foldA` sends `t` to a
representative congruent to `t`; it need not satisfy the S-law.  (2) Moore refinement
(`TowerFin.EP`) on that algebra with output `obsFn`: the stable relation `E` is the largest
congruence inside the kernel of the output, and `E a a'` iff the representatives are `Cong`
(`E_sound`, `rl_E`).  (3) The quotient by `E`, renumbered (`TowerFin.qidx`), is the table; the
S-law holds because `Cong` contains conversion.

Divergences from the paper, all harmless: contexts have any number of holes (`Phi.Ctx`); `M 0` is
S1's blocks with the constant output `hole` (the paper's one-element model has no homomorphism to
the blocks, which `TModel` requires), so `hom 0` is the identity; `M 1` is S1's blocks; for
`d ≥ 1`, `M (d+1) = (lemma7 (M d)).Q`.  The construction is a Lean function of `d` (no
`noncomputable`); it is not meant to be run beyond `d = 1`: the fuel bound `sgB` is astronomical,
although the closure stops as soon as no new signature appears.
-/

namespace Tower
open HnfS TowerFin

/-- Prefix trees (`S`, hole, binary nodes). -/
abbrev Tree : Type := InfNF.PT

/-- Closed S-terms. -/
abbrev CT : Type := Full.PT

/-! ## The bridge: `Full.ObsF` is `Conv.HasObs`, and is invariant under conversion -/

/-- `Conv`'s observable values as `Full`'s. -/
def toOut {M : Type} : Conv.Obs M → Full.Out M
  | .s0 => .hnf []
  | .s1 a => .hnf [a]
  | .s2 a b => .hnf [a, b]
  | .bot f w => .bot f w

/-- The value in a model (`Phi.SModel`) is invariant under weak reduction of closed S-terms. -/
theorem val_inv (𝔐 : Phi.SModel) : Conv.Inv 𝔐.val :=
  sorry

theorem obsF_of_hasObs (𝔐 : Phi.SModel) {t : Term} (ht : PureS t) {x : Conv.Obs 𝔐.M}
    (h : Conv.HasObs 𝔐.val t x) : Full.ObsF 𝔐 t (toOut x) :=
  sorry

/-- **The two observables agree**: `Full.ObsF` over `𝔐` is `Conv.HasObs` over the valuation
`𝔐.val`, up to the encoding `toOut` of the values. -/
theorem obsF_iff_hasObs (𝔐 : Phi.SModel) {t : Term} (ht : PureS t) (o : Full.Out 𝔐.M) :
    Full.ObsF 𝔐 t o ↔ ∃ x, Conv.HasObs 𝔐.val t x ∧ o = toOut x :=
  sorry

/-- **Lemma 3 for the full observable.**  Convertible closed S-terms have the same `ObsF`. -/
theorem obsF_conv (𝔐 : Phi.SModel) {t t' : Term} (ht : PureS t) (ht' : PureS t')
    (h : Conv.Convertible t t') (o : Full.Out 𝔐.M) : Full.ObsF 𝔐 t o ↔ Full.ObsF 𝔐 t' o :=
  sorry

/-! ## Contexts and the syntactic congruence -/

theorem plug_pure (C : Phi.Ctx) {t : Term} (ht : PureS t) : PureS (C.plug t) :=
  sorry

theorem conv_left {f f' : Term} (x : Term) (h : Conv.Convertible f f') :
    Conv.Convertible (f ⬝ x) (f' ⬝ x) :=
  sorry

theorem conv_right (f : Term) {x x' : Term} (h : Conv.Convertible x x') :
    Conv.Convertible (f ⬝ x) (f ⬝ x') :=
  sorry

theorem conv_plug (C : Phi.Ctx) {t t' : Term} (h : Conv.Convertible t t') :
    Conv.Convertible (C.plug t) (C.plug t') :=
  sorry

/-- **The syntactic congruence `≡_O`** of the full observable over `𝔐`: equal observables in
every context (any number of holes). -/
def Cong (𝔐 : Phi.SModel) (t t' : Term) : Prop :=
  ∀ (C : Phi.Ctx) (o : Full.Out 𝔐.M), Full.ObsF 𝔐 (C.plug t) o ↔ Full.ObsF 𝔐 (C.plug t') o

theorem cong_refl (𝔐 : Phi.SModel) (t : Term) : Cong 𝔐 t t :=
  sorry

theorem cong_symm {𝔐 : Phi.SModel} {t t' : Term} (h : Cong 𝔐 t t') : Cong 𝔐 t' t :=
  sorry

theorem cong_trans {𝔐 : Phi.SModel} {t u v : Term} (h : Cong 𝔐 t u) (h' : Cong 𝔐 u v) :
    Cong 𝔐 t v :=
  sorry

/-- **The syntactic congruence contains conversion** (Lemma 3 in every context). -/
theorem cong_of_conv (𝔐 : Phi.SModel) {t t' : Term} (ht : PureS t) (ht' : PureS t')
    (h : Conv.Convertible t t') : Cong 𝔐 t t' :=
  sorry

/-- Composition of contexts. -/
def comp : Phi.Ctx → Phi.Ctx → Phi.Ctx
  | .hole, D => D
  | .s, _ => .s
  | .app c d, D => .app (comp c D) (comp d D)

theorem plug_comp (D : Phi.Ctx) (t : Term) : ∀ C : Phi.Ctx,
    (comp C D).plug t = C.plug (D.plug t) :=
  sorry

theorem cong_ctx {𝔐 : Phi.SModel} {t t' : Term} (h : Cong 𝔐 t t') (D : Phi.Ctx) :
    Cong 𝔐 (D.plug t) (D.plug t') :=
  sorry

/-- A closed S-term as a context without holes. -/
def ofTerm : Term → Phi.Ctx
  | .app f x => .app (ofTerm f) (ofTerm x)
  | _ => .s

theorem plug_ofTerm {r : Term} (hr : PureS r) (t : Term) : (ofTerm r).plug t = r :=
  sorry

theorem cong_left {𝔐 : Phi.SModel} {t t' r : Term} (h : Cong 𝔐 t t') (hr : PureS r) :
    Cong 𝔐 (t ⬝ r) (t' ⬝ r) :=
  sorry

theorem cong_right {𝔐 : Phi.SModel} {t t' r : Term} (h : Cong 𝔐 t t') (hr : PureS r) :
    Cong 𝔐 (r ⬝ t) (r ⬝ t') :=
  sorry

/-! ## The observable as a function -/

/-- The observable read off the end of the head run. -/
def outOf (𝔐 : Phi.SModel) : Term → Full.Out 𝔐.M
  | .app f w =>
    if fold f = 36 then .bot (𝔐.val f) (𝔐.val w)
    else .hnf ((HnfSound.spine (f ⬝ w)).map 𝔐.val)
  | _ => .hnf []

theorem outOf_spec (𝔐 : Phi.SModel) {t u : Term} (ht : PureS t) (hs : Steps t u)
    (hT : Full.Terminal u) : Full.ObsF 𝔐 t (outOf 𝔐 u) :=
  sorry

/-- **The full observable `O`, as a computable function** on closed S-terms. -/
def obsFn (𝔐 : Phi.SModel) (x : CT) : Full.Out 𝔐.M := outOf 𝔐 (Full.headEnd x).1

theorem obsFn_spec (𝔐 : Phi.SModel) (x : CT) : Full.ObsF 𝔐 x.1 (obsFn 𝔐 x) :=
  sorry

theorem obsFn_iff (𝔐 : Phi.SModel) {t : Term} (ht : PureS t) (o : Full.Out 𝔐.M) :
    Full.ObsF 𝔐 t o ↔ o = obsFn 𝔐 ⟨t, ht⟩ :=
  sorry

theorem cong_obsFn {𝔐 : Phi.SModel} {t t' : Term} (h : Cong 𝔐 t t') (ht : PureS t)
    (ht' : PureS t') : obsFn 𝔐 ⟨t, ht⟩ = obsFn 𝔐 ⟨t', ht'⟩ :=
  sorry

/-- The value of a term, from its observable: `s·a₁⋯a_m`, or `f·w`. -/
def outVal (𝔐 : Phi.SModel) : Full.Out 𝔐.M → 𝔐.M
  | .hnf l => l.foldl 𝔐.app 𝔐.s
  | .bot a b => 𝔐.app a b

/-- `O(t)` determines the value of `t`. -/
theorem val_of_obs (𝔐 : Phi.SModel) {t : Term} (ht : PureS t) {o : Full.Out 𝔐.M}
    (h : Full.ObsF 𝔐 t o) : 𝔐.val t = outVal 𝔐 o :=
  sorry

theorem cong_val {𝔐 : Phi.SModel} {t t' : Term} (h : Cong 𝔐 t t') (ht : PureS t)
    (ht' : PureS t') : 𝔐.val t = 𝔐.val t' :=
  sorry

/-! ## Finite models as tables, and their constants -/

/-- A finite S-model as an explicit table: carrier `Fin m`, application as a function, the
S-law, and a homomorphism `φ` to S1's blocks that sends `s` to the block `0` of `S`. -/
structure TModel where
  m : Nat
  ap : Fin m → Fin m → Fin m
  s : Fin m
  law : ∀ a b c : Fin m, ap (ap (ap s a) b) c = ap (ap a c) (ap b c)
  φ : Fin m → Nat
  φ_s : φ s = 0
  φ_app : ∀ a b : Fin m, φ (ap a b) = β (φ a) (φ b)

/-- The table as a model in the sense of `Phi`/`Full`. -/
@[reducible] def TModel.toS (T : TModel) : Phi.SModel where
  M := Fin T.m
  app := T.ap
  s := T.s
  law := T.law
  φ := T.φ
  φ_s := T.φ_s
  φ_app := T.φ_app

/-- The fold of a term into the table. -/
@[reducible] def TModel.val (T : TModel) : Term → Fin T.m := T.toS.val

/-- The fold determines the block. -/
theorem TModel.φ_val (T : TModel) {t : Term} (ht : PureS t) : T.φ (T.val t) = fold t :=
  sorry

theorem sIter_iter (𝔐 : Phi.SModel) : ∀ (k : Nat) (m : 𝔐.M),
    𝔐.sIter k m = iter (𝔐.app 𝔐.s) k m :=
  sorry

theorem fibM_iter (𝔐 : Phi.SModel) : ∀ (k : Nat) (q : 𝔐.M × 𝔐.M),
    𝔐.fibM k q = iter (fun q : 𝔐.M × 𝔐.M => (q.2, 𝔐.app q.1 q.2)) k q :=
  sorry

/-- The threshold `m² + m`. -/
def TModel.L (T : TModel) : Nat := T.m * T.m + T.m

/-- The constant `N` of S6, Section 4. -/
def TModel.N (T : TModel) : Nat := T.L + 10

/-- The constant `p` of S6, Section 4. -/
def TModel.p (T : TModel) : Nat := fact T.L

/-- **The constants exist and are computable**: every finite table satisfies `PeriodicF` with
`N = m² + m + 10` and `p = (m² + m)!`. -/
theorem TModel.periodic (T : TModel) : Full.PeriodicF T.toS T.N T.p :=
  sorry

/-! ## Finite index of the syntactic congruence -/

/-- `S` as a closed term. -/
def cS : CT := ⟨S, .S⟩

/-- Application of closed terms. -/
def capp (t u : CT) : CT := ⟨t.1 ⬝ u.1, .app t.2 u.2⟩

/-- The number of signatures at level 78 (for `≃₇₇`). -/
def sgB (T : TModel) : Nat := Full.sigBound T.m (T.N + T.p) 78

/-- The level-78 signature of Theorem 6, as a number below `sgB T`. -/
def sgc (T : TModel) (t : CT) : Nat :=
  (Full.sigCode 78 (Full.sig T.toS (fun a : Fin T.m => a) T.N T.p T.periodic.hp 78 t)).1

theorem sgc_lt (T : TModel) (t : CT) : sgc T t < sgB T :=
  sorry

/-- Equal signatures: congruent (Theorem 6). -/
theorem sgc_cong (T : TModel) {t t' : CT} (h : sgc T t = sgc T t') : Cong T.toS t.1 t'.1 :=
  sorry

/-- **Finite index**: the syntactic congruence of `O` over a finite table has at most `sgB T`
classes: among any `sgB T + 1` closed S-terms, two are congruent. -/
theorem finite_index (T : TModel) (ts : Nat → Term) (hts : ∀ i, PureS (ts i)) :
    ∃ i j, i < j ∧ j ≤ sgB T ∧ Cong T.toS (ts i) (ts j) :=
  sorry

/-! ## Lemma 7: the quotient by the syntactic congruence -/

deriving instance DecidableEq for Full.Out

section Lemma7
variable (T : TModel)

/-- Step 1: the closure of `{S}` under application modulo signatures. -/
def alg : Alg capp (sgc T) cS := closure capp (sgc T) cS (sgB T) (sgc_lt T)

/-- The representative term of an element of `alg T`. -/
def arep (a : Fin (alg T).n) : CT := (alg T).rep a

theorem arep_mul (a b : Fin (alg T).n) :
    Cong T.toS (arep T ((alg T).mul a b)).1 ((arep T a).1 ⬝ (arep T b).1) :=
  sorry

theorem arep_s : Cong T.toS (arep T (alg T).s).1 S :=
  sorry

/-- The fold into `alg T`. -/
def foldA : Term → Fin (alg T).n
  | .app f x => (alg T).mul (foldA f) (foldA x)
  | _ => (alg T).s

/-- The representative of the fold of `t` is congruent to `t`. -/
theorem foldA_cong {t : Term} (ht : PureS t) : Cong T.toS (arep T (foldA T t)).1 t :=
  sorry

/-- The output of an element: the observable of its representative. -/
def oA (a : Fin (alg T).n) : Full.Out (Fin T.m) := obsFn T.toS (arep T a)

/-- Step 2: the stable Moore relation on `alg T`. -/
abbrev E (a a' : Fin (alg T).n) : Prop :=
  EP (alg T).mul (oA T) (pairs (alg T).n).length a a'

/-- Congruence of the representatives. -/
abbrev Rl (a a' : Fin (alg T).n) : Prop := Cong T.toS (arep T a).1 (arep T a').1

theorem rl_E {a a' : Fin (alg T).n} (h : Rl T a a') (i : Nat) :
    EP (alg T).mul (oA T) i a a' :=
  sorry

theorem E_plug {a a' : Fin (alg T).n} (h : E T a a') : ∀ C : Phi.Ctx,
    E T (foldA T (C.plug (arep T a).1)) (foldA T (C.plug (arep T a').1)) :=
  sorry

theorem obs_foldA {t : Term} (ht : PureS t) : oA T (foldA T t) = obsFn T.toS ⟨t, ht⟩ :=
  sorry

/-- The stable relation is the syntactic congruence, on representatives. -/
theorem E_sound {a a' : Fin (alg T).n} (h : E T a a') : Rl T a a' :=
  sorry

/-- `E`, as a Boolean. -/
def eB (a a' : Fin (alg T).n) : Bool := decide (E T a a')

theorem eB_refl (a : Fin (alg T).n) : eB T a a = true :=
  sorry

theorem eB_symm (a b : Fin (alg T).n) (h : eB T a b = true) : eB T b a = true :=
  sorry

theorem eB_trans (a b c : Fin (alg T).n) (h : eB T a b = true) (h' : eB T b c = true) :
    eB T a c = true :=
  sorry

/-- Step 3: the class of an element, renumbered. -/
def qi (a : Fin (alg T).n) : Fin (qn (eB T)) := qidx (eB T) (eB_refl T) a

/-- The representative element of a class. -/
def qe (q : Fin (qn (eB T))) : Fin (alg T).n := qelt (eB T) q

theorem qe_qi (a : Fin (alg T).n) : E T a (qe T (qi T a)) :=
  sorry

theorem qi_eq {a a' : Fin (alg T).n} (h : E T a a') : qi T a = qi T a' :=
  sorry

theorem qi_qe (q : Fin (qn (eB T))) : qi T (qe T q) = q :=
  sorry

/-- The table of the quotient. -/
def qap (q q' : Fin (qn (eB T))) : Fin (qn (eB T)) := qi T ((alg T).mul (qe T q) (qe T q'))

def qs : Fin (qn (eB T)) := qi T (alg T).s

/-- The fold into the quotient. -/
def qval : Term → Fin (qn (eB T))
  | .app f x => qap T (qval f) (qval x)
  | _ => qs T

/-- The representative term of a class. -/
def qrep (q : Fin (qn (eB T))) : CT := arep T (qe T q)

theorem qval_eq : ∀ t : Term, qval T t = qi T (foldA T t) :=
  sorry

/-- The representative of the class of `t` is congruent to `t`. -/
theorem qrep_cong {t : Term} (ht : PureS t) : Cong T.toS (qrep T (qval T t)).1 t :=
  sorry

/-- The kernel of the fold is the syntactic congruence. -/
theorem qval_iff {t t' : Term} (ht : PureS t) (ht' : PureS t') :
    qval T t = qval T t' ↔ Cong T.toS t t' :=
  sorry

/-- Every class is the fold of its representative term: the quotient is generated by `S`. -/
theorem qval_rep (q : Fin (qn (eB T))) : qval T (qrep T q).1 = q :=
  sorry

theorem qlaw_aux {ta tb tc : Term} (ha : PureS ta) (hb : PureS tb) (hc : PureS tc) :
    qval T (S ⬝ ta ⬝ tb ⬝ tc) = qval T (ta ⬝ tc ⬝ (tb ⬝ tc)) :=
  sorry

/-- The quotient satisfies the S-law, because the congruence contains conversion. -/
theorem qlaw (a b c : Fin (qn (eB T))) :
    qap T (qap T (qap T (qs T) a) b) c = qap T (qap T a c) (qap T b c) :=
  sorry

/-- The homomorphism from the quotient to `T`: the value of the representative. -/
def qh (q : Fin (qn (eB T))) : Fin T.m := T.val (qrep T q).1

theorem qh_val {t : Term} (ht : PureS t) : qh T (qval T t) = T.val t :=
  sorry

theorem qh_app (a b : Fin (qn (eB T))) : qh T (qap T a b) = T.ap (qh T a) (qh T b) :=
  sorry

theorem qh_s : qh T (qs T) = T.s :=
  sorry

/-- The quotient as a table. -/
def quoT : TModel where
  m := qn (eB T)
  ap := qap T
  s := qs T
  law := qlaw T
  φ q := T.φ (qh T q)
  φ_s := by show T.φ (qh T (qs T)) = 0; rw [qh_s]; exact T.φ_s
  φ_app a b := by
    show T.φ (qh T (qap T a b)) = β (T.φ (qh T a)) (T.φ (qh T b))
    rw [qh_app]; exact T.φ_app _ _

theorem quo_val : ∀ t : Term, (quoT T).val t = qval T t :=
  sorry

end Lemma7

/-- The data of Lemma 7 for a table `T`: the quotient `Q` of closed S-terms by the syntactic
congruence of `O` over `T`, as a table. -/
structure Quo (T : TModel) where
  /-- the quotient -/
  Q : TModel
  /-- the observable over `T`, read off the quotient -/
  obs : Fin Q.m → Full.Out (Fin T.m)
  /-- the homomorphism to `T` -/
  h : Fin Q.m → Fin T.m
  /-- a term for each element: `Q` is generated by `S` -/
  rep : Fin Q.m → Term
  rep_pure : ∀ q, PureS (rep q)
  rep_val : ∀ q, Q.val (rep q) = q
  /-- the kernel of the fold is the syntactic congruence -/
  syn : ∀ t t' : Term, PureS t → PureS t' → (Q.val t = Q.val t' ↔ Cong T.toS t t')
  /-- the fold computes the observable -/
  obs_spec : ∀ t : Term, PureS t → Full.ObsF T.toS t (obs (Q.val t))
  h_val : ∀ t : Term, PureS t → h (Q.val t) = T.val t
  φ_h : ∀ q, Q.φ q = T.φ (h q)

/-- **Lemma 7.**  For a finite S-model given as a table, the quotient of closed S-terms by the
syntactic congruence of the full observable is a finite S-model generated by `S`, with a
computable table; its fold computes the observable. -/
def lemma7 (T : TModel) : Quo T where
  Q := quoT T
  obs q := obsFn T.toS (qrep T q)
  h := qh T
  rep q := (qrep T q).1
  rep_pure q := (qrep T q).2
  rep_val q := (quo_val T _).trans (qval_rep T q)
  syn t t' ht ht' := by rw [quo_val, quo_val]; exact qval_iff T ht ht'
  obs_spec t ht := by
    rw [quo_val]
    exact (qrep_cong T ht .hole _).mp (obsFn_spec T.toS _)
  h_val t ht := by rw [quo_val]; exact qh_val T ht
  φ_h _ := rfl

/-- **The syntactic congruence is decidable** (Lemma 7). -/
def decCong (T : TModel) {t t' : Term} (ht : PureS t) (ht' : PureS t') :
    Decidable (Cong T.toS t t') :=
  decidable_of_iff _ ((lemma7 T).syn t t' ht ht')

theorem Quo.gen {T : TModel} (q : Quo T) (a : Fin q.Q.m) : ∃ t, PureS t ∧ q.Q.val t = a :=
  sorry

/-- `h` fixes `s`. -/
theorem Quo.h_s {T : TModel} (q : Quo T) : q.h q.Q.s = T.s :=
  sorry

/-- `h` is a homomorphism. -/
theorem Quo.h_app {T : TModel} (q : Quo T) (a b : Fin q.Q.m) :
    q.h (q.Q.ap a b) = T.ap (q.h a) (q.h b) :=
  sorry

/-! ## The reduction: `π_{d+1}` is a function of `O` over `M_d` -/

/-- The function `F` of the proof of Theorem 1: the depth-`(d+1)` prefix from the observable,
given the depth-`d` outputs `o` and the depth-`(d−1)` outputs `o'` (used for the first item of
`S a b`). -/
def outF {M : Type} (o o' : M → Tree) : Full.Out M → Tree
  | .hnf [] => .S
  | .hnf [a] => .app .S (o a)
  | .hnf [a, b] => .app (.app .S (o' a)) (o b)
  | .hnf _ => .hole
  | .bot f w => .app (o f) (o w)

/-- **The reduction.**  If `𝔐` computes `π_d` through `o` and `π_{d−1}` through `o'`, then
`π_{d+1}(t) = outF o o' (O(t))`. -/
theorem reduction (𝔐 : Phi.SModel) (d : Nat) (o o' : 𝔐.M → Tree)
    (H : ∀ t : Term, PureS t → D2.Pre d t (o (𝔐.val t)))
    (H' : ∀ t : Term, PureS t → D2.Pre (d - 1) t (o' (𝔐.val t)))
    {t : Term} (ht : PureS t) {x : Full.Out 𝔐.M} (hx : Full.ObsF 𝔐 t x) :
    D2.Pre (d + 1) t (outF o o' x) :=
  sorry

/-- **The reduction, with the homomorphism** `h : M_d → M_{d−1}` as in the paper: if `M_d`
computes `π_d` through `o_d`, and `M_{d−1}` (any valuation `v'` with `h ∘ M_d = v'`) computes
`π_{d−1}` through `o_{d−1}`, then `Pre (d+1) t P` iff `P = outF o_d (o_{d−1} ∘ h) (O(t))`. -/
theorem reduction_hom (𝔐 : Phi.SModel) {M' : Type} (v' : Term → M') (h : 𝔐.M → M')
    (hh : ∀ t : Term, PureS t → h (𝔐.val t) = v' t) (d : Nat) (o : 𝔐.M → Tree) (o' : M' → Tree)
    (H : ∀ t : Term, PureS t → D2.Pre d t (o (𝔐.val t)))
    (H' : ∀ t : Term, PureS t → D2.Pre (d - 1) t (o' (v' t)))
    {t : Term} (ht : PureS t) (P : Tree) :
    D2.Pre (d + 1) t P ↔ P = outF o (fun a => o' (h a)) (obsFn 𝔐 ⟨t, ht⟩) :=
  sorry

/-! ## The base: S1's blocks -/

/-- S1's 38 blocks as a table. -/
def s1T : TModel where
  m := 38
  ap a b := ⟨β a.1 b.1, β_lt a.2 b.2⟩
  s := ⟨0, by decide⟩
  law a b c := Fin.eq_of_val_eq (compat a.2 b.2 c.2)
  φ a := a.1
  φ_s := rfl
  φ_app _ _ := rfl

def pureB : Term → Bool
  | .S => true
  | .app f x => pureB f && pureB x
  | _ => false

theorem pureB_sound : ∀ {t : Term}, pureB t = true → PureS t :=
  sorry

/-- A closed S-term for each block (found by closing `{S}` under `β`). -/
def s1Reps : List Term := [S,
  (S ⬝ S),
  (S ⬝ (S ⬝ S)),
  ((S ⬝ S) ⬝ S),
  (S ⬝ (S ⬝ (S ⬝ S))),
  (S ⬝ ((S ⬝ S) ⬝ S)),
  ((S ⬝ S) ⬝ (S ⬝ S)),
  ((S ⬝ (S ⬝ S)) ⬝ S),
  (S ⬝ (S ⬝ (S ⬝ (S ⬝ S)))),
  (S ⬝ (S ⬝ ((S ⬝ S) ⬝ S))),
  (S ⬝ ((S ⬝ S) ⬝ (S ⬝ S))),
  (S ⬝ ((S ⬝ (S ⬝ S)) ⬝ S)),
  ((S ⬝ S) ⬝ (S ⬝ (S ⬝ S))),
  ((S ⬝ (S ⬝ S)) ⬝ (S ⬝ S)),
  ((S ⬝ (S ⬝ S)) ⬝ (S ⬝ (S ⬝ S))),
  ((S ⬝ (S ⬝ (S ⬝ S))) ⬝ S),
  ((S ⬝ ((S ⬝ S) ⬝ S)) ⬝ S),
  (S ⬝ (S ⬝ (S ⬝ (S ⬝ (S ⬝ S))))),
  (S ⬝ ((S ⬝ (S ⬝ S)) ⬝ (S ⬝ (S ⬝ S)))),
  (S ⬝ ((S ⬝ (S ⬝ (S ⬝ S))) ⬝ S)),
  (S ⬝ ((S ⬝ ((S ⬝ S) ⬝ S)) ⬝ S)),
  ((S ⬝ (S ⬝ S)) ⬝ ((S ⬝ S) ⬝ S)),
  (((S ⬝ S) ⬝ S) ⬝ (S ⬝ (S ⬝ S))),
  (((S ⬝ S) ⬝ S) ⬝ ((S ⬝ S) ⬝ S)),
  ((S ⬝ ((S ⬝ S) ⬝ S)) ⬝ (S ⬝ S)),
  (((S ⬝ S) ⬝ S) ⬝ ((S ⬝ (S ⬝ S)) ⬝ S)),
  ((S ⬝ ((S ⬝ S) ⬝ (S ⬝ S))) ⬝ S),
  (S ⬝ ((S ⬝ (S ⬝ S)) ⬝ (S ⬝ (S ⬝ (S ⬝ S))))),
  (S ⬝ (((S ⬝ S) ⬝ S) ⬝ (S ⬝ (S ⬝ S)))),
  ((S ⬝ (S ⬝ S)) ⬝ (S ⬝ (S ⬝ (S ⬝ S)))),
  (((S ⬝ S) ⬝ S) ⬝ (S ⬝ (S ⬝ (S ⬝ S)))),
  (((S ⬝ S) ⬝ S) ⬝ (S ⬝ ((S ⬝ S) ⬝ S))),
  (((S ⬝ S) ⬝ (S ⬝ S)) ⬝ ((S ⬝ S) ⬝ (S ⬝ S))),
  (((S ⬝ S) ⬝ (S ⬝ S)) ⬝ ((S ⬝ S) ⬝ S)),
  (((S ⬝ (S ⬝ S)) ⬝ (S ⬝ (S ⬝ (S ⬝ S)))) ⬝ S),
  ((S ⬝ ((S ⬝ (S ⬝ (S ⬝ S))) ⬝ S)) ⬝ S),
  ((((S ⬝ S) ⬝ S) ⬝ ((S ⬝ S) ⬝ S)) ⬝ ((S ⬝ S) ⬝ S)),
  ((S ⬝ (((S ⬝ S) ⬝ S) ⬝ (S ⬝ (S ⬝ S)))) ⬝ S)]

def s1RepsB : Bool :=
  r38.all fun i => pureB (s1Reps.getD i S) && Nat.beq (fold (s1Reps.getD i S)) i

theorem s1RepsB_eq : s1RepsB = true :=
  sorry

/-- Every block is the block of a closed S-term: S1's table is generated by `S`. -/
theorem s1Reps_spec {i : Nat} (hi : i < 38) :
    PureS (s1Reps.getD i S) ∧ fold (s1Reps.getD i S) = i :=
  sorry

/-- A block of the form `β 0 x`. -/
def isOne (b : Nat) : Bool := r38.any fun x => Nat.beq (β 0 x) b

/-- The depth-1 prefix of a term with block `b`. -/
def o1 (b : Nat) : Tree :=
  if b = 36 then .app .hole .hole
  else if b = 0 then .S
  else if isOne b = true then .app .S .hole
  else .app (.app .S .hole) .hole

/-- **Depth 1**: the block determines the depth-1 prefix. -/
theorem pre1_block {t : Term} (ht : PureS t) : D2.Pre 1 t (o1 (fold t)) :=
  sorry

/-! ## Theorem 1: the tower -/

/-- Level `d` of the tower: a table `T = M_d`, generated by `S`, with the outputs `out = o_d`
and `outP = o_{d−1} ∘ h_d`. -/
structure Level (d : Nat) where
  T : TModel
  out : Fin T.m → Tree
  outP : Fin T.m → Tree
  rep : Fin T.m → Term
  rep_pure : ∀ a, PureS (rep a)
  rep_val : ∀ a, T.val (rep a) = a
  spec : ∀ t : Term, PureS t → D2.Pre d t (out (T.val t))
  specP : ∀ t : Term, PureS t → D2.Pre (d - 1) t (outP (T.val t))

theorem s1_rep_val (a : Fin 38) : s1T.val (s1Reps.getD a.1 S) = a :=
  sorry

/-- `M_0`: S1's blocks with the constant output (see the module header). -/
def base0 : Level 0 where
  T := s1T
  out _ := .hole
  outP _ := .hole
  rep a := s1Reps.getD a.1 S
  rep_pure a := (s1Reps_spec a.2).1
  rep_val := s1_rep_val
  spec t _ := .zero t
  specP t _ := .zero t

/-- `M_1`: S1's blocks. -/
def base1 : Level 1 where
  T := s1T
  out a := o1 a.1
  outP _ := .hole
  rep a := s1Reps.getD a.1 S
  rep_pure a := (s1Reps_spec a.2).1
  rep_val := s1_rep_val
  spec t ht := by
    show D2.Pre 1 t (o1 (s1T.φ (s1T.val t)))
    rw [s1T.φ_val ht]
    exact pre1_block ht
  specP t _ := .zero t

/-- The step: `M_{d+1}` is the quotient of Lemma 7 over `M_d`, and `o_{d+1}` is `outF`. -/
def next {d : Nat} (L : Level d) : Level (d + 1) where
  T := (lemma7 L.T).Q
  out q := outF L.out L.outP ((lemma7 L.T).obs q)
  outP q := L.out ((lemma7 L.T).h q)
  rep := (lemma7 L.T).rep
  rep_pure := (lemma7 L.T).rep_pure
  rep_val := (lemma7 L.T).rep_val
  spec t ht := reduction L.T.toS d L.out L.outP L.spec L.specP ht ((lemma7 L.T).obs_spec t ht)
  specP t ht := by
    show D2.Pre d t (L.out ((lemma7 L.T).h ((lemma7 L.T).Q.val t)))
    rw [(lemma7 L.T).h_val t ht]
    exact L.spec t ht

/-- **The tower**, as a function of the depth. -/
def levels : (d : Nat) → Level d
  | 0 => base0
  | 1 => base1
  | d + 2 => next (levels (d + 1))

/-- The model `M_d`, as a table. -/
def M (d : Nat) : TModel := (levels d).T

/-- The output map `o_d`. -/
def o (d : Nat) : Fin (M d).m → Tree := (levels d).out

/-- The homomorphism `h_{d+1} : M_{d+1} → M_d`. -/
def hom : (d : Nat) → Fin (M (d + 1)).m → Fin (M d).m
  | 0 => fun a => a
  | d + 1 => (lemma7 (levels (d + 1)).T).h

/-- **Theorem 1 (Prefix Regularity).**  For every `d`, the depth-`d` prefix of a closed S-term
`t` is `o d` of the fold of `t` into the finite table `M d`. -/
theorem prefix_regularity (d : Nat) {t : Term} (ht : PureS t) (P : Tree) :
    D2.Pre d t P ↔ P = o d ((M d).val t) :=
  sorry

/-- `M d` is generated by `S`: every element is the fold of a closed S-term. -/
theorem generated (d : Nat) (a : Fin (M d).m) : ∃ t, PureS t ∧ (M d).val t = a :=
  sorry

/-- `M d` maps to S1's blocks: `φ` of the fold is the block. -/
theorem block (d : Nat) {t : Term} (ht : PureS t) : (M d).φ ((M d).val t) = fold t :=
  sorry

/-- `hom d` composed with the fold into `M (d+1)` is the fold into `M d`. -/
theorem hom_val : ∀ (d : Nat) {t : Term}, PureS t → hom d ((M (d + 1)).val t) = (M d).val t :=
  sorry

theorem hom_s (d : Nat) : hom d (M (d + 1)).s = (M d).s :=
  sorry

/-- `hom d` is a homomorphism of S-models. -/
theorem hom_app (d : Nat) (a b : Fin (M (d + 1)).m) :
    hom d ((M (d + 1)).ap a b) = (M d).ap (hom d a) (hom d b) :=
  sorry

/-- The homomorphisms to the blocks commute with `hom`. -/
theorem hom_φ (d : Nat) (a : Fin (M (d + 1)).m) : (M (d + 1)).φ a = (M d).φ (hom d a) :=
  sorry

/-- `M 0` and `M 1` are S1's 38 blocks; above, the quotient of Lemma 7. -/
theorem M_zero : M 0 = s1T :=
  sorry

/-- For `d ≥ 1`, the kernel of the fold into `M (d+1)` is the syntactic congruence of the full
observable over `M d`. -/
theorem M_syn (d : Nat) {t t' : Term} (ht : PureS t) (ht' : PureS t') :
    (M (d + 2)).val t = (M (d + 2)).val t' ↔ Cong (M (d + 1)).toS t t' :=
  sorry

/-- **Theorem 1**, assembled: for every `d` the table `M d` (a Lean function of `d`), generated
by `S`, computes the depth-`d` prefix through `o d`, maps to S1's blocks, and maps to `M (d−1)`
by a homomorphism compatible with the folds. -/
theorem theorem_one (d : Nat) :
    (∀ (t : Term), PureS t → ∀ P : Tree, D2.Pre d t P ↔ P = o d ((M d).val t)) ∧
    (∀ a : Fin (M d).m, ∃ t, PureS t ∧ (M d).val t = a) ∧
    (∀ t : Term, PureS t → (M d).φ ((M d).val t) = fold t) ∧
    (∀ t : Term, PureS t → hom d ((M (d + 1)).val t) = (M d).val t) ∧
    (∀ a b : Fin (M (d + 1)).m, hom d ((M (d + 1)).ap a b) = (M d).ap (hom d a) (hom d b)) :=
  sorry

/-! ## Corollary 2 -/

/-- `P ∈ o_d(M_d)`. -/
def realizable (d : Nat) (P : Tree) : Bool :=
  (List.finRange (M d).m).any fun a => decide (o d a = P)

/-- **Corollary 2.**  Some closed S-term has depth-`d` prefix `P` iff `P ∈ o_d(M_d)`. -/
theorem realizable_iff (d : Nat) (P : Tree) :
    realizable d P = true ↔ ∃ t, PureS t ∧ D2.Pre d t P :=
  sorry

/-- **Corollary 2**: it is decidable whether some closed S-term has depth-`d` prefix `P`. -/
instance realizableDec (d : Nat) (P : Tree) : Decidable (∃ t, PureS t ∧ D2.Pre d t P) :=
  decidable_of_iff _ (realizable_iff d P)

end Tower
