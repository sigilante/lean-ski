/-- The front end compiles the ASCII text to every term `skijack` emits
    (`Front.agrees_termOf`), and to no other (`Front.agrees_termOf_rev`). -/
theorem macros_agrees : agrees (compileWith false macrosText) macrosTerms = true := by
  decide +kernel

/-- And the Unicode text, to the same terms. -/
theorem macros_unicode_agrees : agrees (compileWith true macrosTextU) macrosTerms = true := by
  decide +kernel

/-- The simulation applies: the compiled program is the compiler's for the source. -/
theorem macros_fixed : Fixed (progOf macrosText) (genvOf macrosText) :=
  fixed_of_check (by decide +kernel)
